// declarations for sync.rs

cfun yukistd_sync_mutex_create() -> uint64
cfun yukistd_sync_mutex_lock(id: uint64)
cfun yukistd_sync_mutex_try_lock(id: uint64) -> bool
cfun yukistd_sync_mutex_unlock(id: uint64)
cfun yukistd_sync_mutex_destroy(id: uint64)

cfun yukistd_sync_rwlock_create() -> uint64
cfun yukistd_sync_rwlock_read_lock(id: uint64)
cfun yukistd_sync_rwlock_try_read_lock(id: uint64) -> bool
cfun yukistd_sync_rwlock_read_unlock(id: uint64)
cfun yukistd_sync_rwlock_write_lock(id: uint64)
cfun yukistd_sync_rwlock_try_write_lock(id: uint64) -> bool
cfun yukistd_sync_rwlock_write_unlock(id: uint64)
cfun yukistd_sync_rwlock_destroy(id: uint64)

cfun yukistd_sync_condvar_create() -> uint64
cfun yukistd_sync_condvar_wait(cond_id: uint64, mutex_id: uint64)
cfun yukistd_sync_condvar_wait_timeout(cond_id: uint64, mutex_id: uint64, ms: uint64) -> bool
cfun yukistd_sync_condvar_notify_one(cond_id: uint64)
cfun yukistd_sync_condvar_notify_all(cond_id: uint64)
cfun yukistd_sync_condvar_destroy(cond_id: uint64)

cfun yukistd_sync_once_create() -> uint64
cfun yukistd_sync_once_call(id: uint64, task: ptr<void>, arg: ptr<void>)
cfun yukistd_sync_once_is_completed(id: uint64) -> bool
cfun yukistd_sync_once_destroy(id: uint64)

cfun yukistd_sync_channel_create(bound: int64) -> uint64
cfun yukistd_sync_channel_send(id: uint64, val: int64) -> bool
cfun yukistd_sync_channel_recv(id: uint64, timeout_ms: int64, out_val: ptr<int64>) -> int32
cfun yukistd_sync_channel_close(id: uint64)
cfun yukistd_sync_channel_is_closed(id: uint64) -> bool
cfun yukistd_sync_channel_len(id: uint64) -> int64
cfun yukistd_sync_channel_destroy(id: uint64)

cfun yukistd_sync_semaphore_create(permits: int64) -> uint64
cfun yukistd_sync_semaphore_acquire(id: uint64)
cfun yukistd_sync_semaphore_try_acquire(id: uint64) -> bool
cfun yukistd_sync_semaphore_release(id: uint64)
cfun yukistd_sync_semaphore_destroy(id: uint64)

cfun yukistd_sync_barrier_create(parties: uint32) -> uint64
cfun yukistd_sync_barrier_wait(id: uint64) -> bool
cfun yukistd_sync_barrier_destroy(id: uint64)

cfun yukistd_sync_atomic_i64_create(init: int64) -> uint64
cfun yukistd_sync_atomic_i64_load(id: uint64) -> int64
cfun yukistd_sync_atomic_i64_store(id: uint64, val: int64)
cfun yukistd_sync_atomic_i64_fetch_add(id: uint64, val: int64) -> int64
cfun yukistd_sync_atomic_i64_fetch_sub(id: uint64, val: int64) -> int64
cfun yukistd_sync_atomic_i64_swap(id: uint64, val: int64) -> int64
cfun yukistd_sync_atomic_i64_cas(id: uint64, expected: int64, desired: int64) -> bool
cfun yukistd_sync_atomic_i64_destroy(id: uint64)

