        }
        yukistd_sync_rwlock_read_lock(this.handle)
    }

    public fun try_read() -> bool {
        if this.handle == 0 {
            return false
        }
        return yukistd_sync_rwlock_try_read_lock(this.handle)
    }

    public fun unlock_read() {
        if this.handle == 0 {
            panic(SyncError {
                message: "invalid rwlock handle (0)",
                code: 401,
            })
        }
        yukistd_sync_rwlock_read_unlock(this.handle)
