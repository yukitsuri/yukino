            })
        }
        yukistd_sync_rwlock_write_lock(this.handle)
    }

    public fun try_write() -> bool {
        if this.handle == 0 {
            return false
        }
        return yukistd_sync_rwlock_try_write_lock(this.handle)
    }

    public fun unlock_write() {
        if this.handle == 0 {
            panic(SyncError {
                message: "invalid rwlock handle (0)",
                code: 401,
            })
        }
        yukistd_sync_rwlock_write_unlock(this.handle)
