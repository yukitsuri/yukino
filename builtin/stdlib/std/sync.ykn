// atomic int64

public class AtomicInt64 {
    handle: uint64

    public fun init(init_val: int64 = 0) {
        set id = yukistd_sync_atomic_i64_create(init_val)
        if id == 0 {
            panic(SyncError {
                message: "failed to create atomic_i64",
                code: 401,
            })
        }
        rewrite this.handle = id
    }

    public fun get() -> int64 {
        if this.handle == 0 {
            return 0
        }
        return yukistd_sync_atomic_i64_load(this.handle)
    }

    public fun set(val: int64) {
        if this.handle != 0 {
            yukistd_sync_atomic_i64_store(this.handle, val)
        }
    }

    public fun fetch_add(val: int64) -> int64 {
        if this.handle == 0 {
            return 0
        }
        return yukistd_sync_atomic_i64_fetch_add(this.handle, val)
    }

    public fun fetch_sub(val: int64) -> int64 {
        if this.handle == 0 {
            return 0
        }
        return yukistd_sync_atomic_i64_fetch_sub(this.handle, val)
    }

    public fun swap(val: int64) -> int64 {
        if this.handle == 0 {
            return 0
        }
        return yukistd_sync_atomic_i64_swap(this.handle, val)
    }

    public fun compare_exchange(expected: int64, desired: int64) -> bool {
        if this.handle == 0 {
            return false
        }
        return yukistd_sync_atomic_i64_cas(this.handle, expected, desired)
    }

    public fun destroy() {
        if this.handle != 0 {
            yukistd_sync_atomic_i64_destroy(this.handle)
            rewrite this.handle = 0
        }
    }

    public fun get_handle() -> uint64 {
        return this.handle
    }
}

public fun atomic_i64(init_val: int64 = 0) -> AtomicInt64 {
    return init AtomicInt64(init_val)
}

