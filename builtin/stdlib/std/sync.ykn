cfun yukistd_sync_atomic_bool_load(id: uint64) -> bool
cfun yukistd_sync_atomic_bool_store(id: uint64, val: bool)
cfun yukistd_sync_atomic_bool_swap(id: uint64, val: bool) -> bool
cfun yukistd_sync_atomic_bool_cas(id: uint64, expected: bool, desired: bool) -> bool
cfun yukistd_sync_atomic_bool_destroy(id: uint64)

// synchronization errors

public struct SyncError {
    message: string
    code: int32
}

// mutex

public class Mutex {
    handle: uint64

    public fun init() {
        set id = yukistd_sync_mutex_create()
        if id == 0 {
            panic(SyncError {
                message: "failed to create mutex",
                code: 401,
            })
        }
        rewrite this.handle = id
    }

    public fun lock() {
        if this.handle == 0 {
            panic(SyncError {
                message: "invalid mutex handle (0)",
                code: 401,
            })
        }
        yukistd_sync_mutex_lock(this.handle)
    }

    public fun try_lock() -> bool {
        if this.handle == 0 {
            return false
        }
        return yukistd_sync_mutex_try_lock(this.handle)
    }

    public fun unlock() {
        if this.handle == 0 {
            panic(SyncError {
                message: "invalid mutex handle (0)",
                code: 401,
            })
        }
        yukistd_sync_mutex_unlock(this.handle)
    }

    public fun destroy() {
        if this.handle != 0 {
            yukistd_sync_mutex_destroy(this.handle)
            rewrite this.handle = 0
        }
    }

    public fun get_handle() -> uint64 {
        return this.handle
    }
}

public fun mutex() -> Mutex {
    return init Mutex()
}

