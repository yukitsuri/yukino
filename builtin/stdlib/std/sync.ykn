    return init RwLock()
}

// condvar

public class CondVar {
    handle: uint64

    public fun init() {
        set id = yukistd_sync_condvar_create()
        if id == 0 {
            panic(SyncError {
                message: "failed to create condvar",
                code: 401,
            })
        }
        rewrite this.handle = id
    }

    public fun wait(ref m: Mutex) {
        if this.handle == 0 || m.handle == 0 {
            panic(SyncError {
                message: "invalid handle in condvar wait",
                code: 401,
            })
        }
        yukistd_sync_condvar_wait(this.handle, m.handle)
    }

    public fun wait_handle(mutex_id: uint64) {
        if this.handle == 0 || mutex_id == 0 {
            panic(SyncError {
                message: "invalid handle in condvar wait_handle",
                code: 401,
            })
        }
        yukistd_sync_condvar_wait(this.handle, mutex_id)
    }

    public fun wait_timeout(ref m: Mutex, ms: uint64) -> bool {
        if this.handle == 0 || m.handle == 0 {
            panic(SyncError {
                message: "invalid handle in condvar wait_timeout",
                code: 401,
            })
        }
        return yukistd_sync_condvar_wait_timeout(this.handle, m.handle, ms)
    }

    public fun notify_one() {
        if this.handle != 0 {
            yukistd_sync_condvar_notify_one(this.handle)
        }
    }

    public fun notify_all() {
        if this.handle != 0 {
            yukistd_sync_condvar_notify_all(this.handle)
        }
    }

    public fun destroy() {
        if this.handle != 0 {
            yukistd_sync_condvar_destroy(this.handle)
            rewrite this.handle = 0
        }
    }

    public fun get_handle() -> uint64 {
        return this.handle
    }
}

public fun condvar() -> CondVar {
    return init CondVar()
}

// once

public class Once {
    handle: uint64

    public fun init() {
        set id = yukistd_sync_once_create()
        if id == 0 {
            panic(SyncError {
                message: "failed to create once",
                code: 401,
            })
        }
        rewrite this.handle = id
    }

    public fun call_once(task: ptr<void>, arg: ptr<void> = null) {
        if this.handle == 0 {
            panic(SyncError {
                message: "invalid once handle (0)",
                code: 401,
            })
        }
        yukistd_sync_once_call(this.handle, task, arg)
    }

    public fun is_completed() -> bool {
        if this.handle == 0 {
            return false
        }
        return yukistd_sync_once_is_completed(this.handle)
    }

    public fun destroy() {
        if this.handle != 0 {
            yukistd_sync_once_destroy(this.handle)
            rewrite this.handle = 0
        }
    }

    public fun get_handle() -> uint64 {
        return this.handle
    }
}

public fun once() -> Once {
    return init Once()
}

// channel

public class Channel {
    handle: uint64

    public fun init(bound: int64 = 0) {
        set id = yukistd_sync_channel_create(bound)
        if id == 0 {
            panic(SyncError {
                message: "failed to create channel",
                code: 401,
            })
        }
        rewrite this.handle = id
    }

    public fun send_i64(val: int64) -> bool {
        if this.handle == 0 {
            return false
        }
        return yukistd_sync_channel_send(this.handle, val)
    }

    public fun recv_i64() -> int64? {
        if this.handle == 0 {
            return null
        }
        set out_val: int64 = 0
        set res = yukistd_sync_channel_recv(this.handle, -1, ptr_of(out_val))
        if res != 0 {
            return null
        }
        return out_val
    }

    public fun try_recv_i64() -> int64? {
        if this.handle == 0 {
            return null
        }
        set out_val: int64 = 0
        set res = yukistd_sync_channel_recv(this.handle, 0, ptr_of(out_val))
        if res != 0 {
            return null
        }
        return out_val
    }

    public fun recv_timeout_i64(timeout_ms: int64) -> int64? {
        if this.handle == 0 {
            return null
        }
        set out_val: int64 = 0
        set res = yukistd_sync_channel_recv(this.handle, timeout_ms, ptr_of(out_val))
        if res != 0 {
            return null
        }
        return out_val
    }

    public fun send_ptr(p: ptr<void>) -> bool {
        if this.handle == 0 {
            return false
        }
        return yukistd_sync_channel_send(this.handle, cast(p, "int64"))
    }

    public fun recv_ptr() -> ptr<void>? {
        set v = this.recv_i64()
        if v == null {
            return null
        }
        return cast(v ?? 0, "ptr<void>")
    }

    public fun try_recv_ptr() -> ptr<void>? {
        set v = this.try_recv_i64()
        if v == null {
            return null
        }
        return cast(v ?? 0, "ptr<void>")
    }

    public fun close() {
        if this.handle != 0 {
            yukistd_sync_channel_close(this.handle)
        }
    }

    public fun is_closed() -> bool {
        if this.handle == 0 {
            return true
        }
        return yukistd_sync_channel_is_closed(this.handle)
    }

    public fun len() -> int64 {
        if this.handle == 0 {
            return 0
        }
        return yukistd_sync_channel_len(this.handle)
    }

    public fun destroy() {
        if this.handle != 0 {
            yukistd_sync_channel_destroy(this.handle)
            rewrite this.handle = 0
        }
    }

    public fun get_handle() -> uint64 {
        return this.handle
    }
}

public fun channel(bound: int64 = 0) -> Channel {
    return init Channel(bound)
}

// semaphore

public class Semaphore {
    handle: uint64

    public fun init(permits: int64 = 1) {
        set id = yukistd_sync_semaphore_create(permits)
        if id == 0 {
            panic(SyncError {
                message: "failed to create semaphore",
                code: 401,
            })
        }
        rewrite this.handle = id
    }

    public fun acquire() -> bool {
        if this.handle == 0 {
            panic(SyncError {
                message: "invalid semaphore handle (0)",
                code: 401,
            })
        }
        yukistd_sync_semaphore_acquire(this.handle)
        return true
    }

    public fun try_acquire() -> bool {
        if this.handle == 0 {
            return false
        }
        return yukistd_sync_semaphore_try_acquire(this.handle)
    }

    public fun release() -> bool {
        if this.handle == 0 {
            panic(SyncError {
                message: "invalid semaphore handle (0)",
                code: 401,
            })
        }
        yukistd_sync_semaphore_release(this.handle)
        return true
    }

    public fun destroy() {
        if this.handle != 0 {
            yukistd_sync_semaphore_destroy(this.handle)
            rewrite this.handle = 0
        }
    }

    public fun get_handle() -> uint64 {
        return this.handle
    }
}

public fun semaphore(permits: int64 = 1) -> Semaphore {
    return init Semaphore(permits)
}

