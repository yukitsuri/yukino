#[inline]
public fun gf_new() -> int64[] {
    set o: int64[] = []
    for i in 0..16 {
        o.push(0)
    }
    return o
}

#[inline]
public fun car25519(ref ~o: int64[]) {
    for i in 0..16 {
        rewrite o[i] = o[i] + 65536
        set c: int64 = o[i] >> 16
        if i < 15 {
            rewrite o[i + 1] = o[i + 1] + c - 1
        } else {
            rewrite o[0] = o[0] + 38 * (c - 1)
        }
        rewrite o[i] = o[i] - (c << 16)
    }
}

#[inline]
public fun gf_cswap(ref ~p: int64[], ref ~q: int64[], b: int64) {
    set mask: int64 = ~(b - 1)
    for i in 0..16 {
        set t: int64 = mask & (p[i] ^ q[i])
        rewrite p[i] = p[i] ^ t
        rewrite q[i] = q[i] ^ t
    }
}

#[inline]
public fun gf_add(ref a: int64[], ref b: int64[]) -> int64[] {
    set o: int64[] = []
    for i in 0..16 {
        o.push(a[i] + b[i])
    }
    return o
}

#[inline]
public fun gf_sub(ref a: int64[], ref b: int64[]) -> int64[] {
    set o: int64[] = []
    for i in 0..16 {
        o.push(a[i] - b[i])
    }
    return o
}

public fun gf_mul(ref a: int64[], ref b: int64[]) -> int64[] {
    set t: int64[] = []
    for i in 0..31 {
        t.push(0)
    }
    for i in 0..16 {
        for j in 0..16 {
            rewrite t[i + j] = t[i + j] + a[i] * b[j]
        }
    }
    for i in 0..15 {
        rewrite t[i] = t[i] + 38 * t[i + 16]
    }
    set o: int64[] = []
    for i in 0..16 {
        o.push(t[i])
    }
    car25519(ref ~o)
    car25519(ref ~o)
    return o
}

#[inline_always]
public fun gf_sqr(ref a: int64[]) -> int64[] {
    return gf_mul(ref a, ref a)
}

public fun gf_inv(ref i: int64[]) -> int64[] {
    set c: int64[] = []
    for k in 0..16 {
        c.push(i[k])
    }
    set a: int64 = 253
    while a >= 0 {
        rewrite c = gf_sqr(ref c)
        if a != 2 && a != 4 {
            rewrite c = gf_mul(ref c, ref i)
        }
        rewrite a = a - 1
    }
    return c
}

public fun pow2523(ref i: int64[]) -> int64[] {
    set c: int64[] = []
    for k in 0..16 {
        c.push(i[k])
    }
    set a: int64 = 250
    while a >= 0 {
        rewrite c = gf_sqr(ref c)
        if a != 1 {
            rewrite c = gf_mul(ref c, ref i)
        }
        rewrite a = a - 1
    }
    return c
}

public fun unpack25519(ref ~o: int64[], ref n: bytes) {
    for i in 0..16 {
        set lo: int64 = cast(n[2 * i], "int64")
        set hi: int64 = cast(n[2 * i + 1], "int64")
        rewrite o[i] = lo + (hi << 8)
    }
    rewrite o[15] = o[15] & 0x7fff
}

public fun pack25519(ref ~out_buf: uint8[], ref n: int64[]) {
    set t: int64[] = []
    for i in 0..16 {
        t.push(n[i])
    }
    car25519(ref ~t)
    car25519(ref ~t)
    car25519(ref ~t)
    for j in 0..2 {
        set m: int64[] = []
        for k in 0..16 {
            m.push(0)
        }
        rewrite m[0] = t[0] - 0xffed
        for i in 1..15 {
            rewrite m[i] = t[i] - 0xffff - ((m[i - 1] >> 16) & 1)
            rewrite m[i - 1] = m[i - 1] & 0xffff
        }
        rewrite m[15] = t[15] - 0x7fff - ((m[14] >> 16) & 1)
        set b: int64 = (m[15] >> 16) & 1
        rewrite m[14] = m[14] & 0xffff
        gf_cswap(ref ~t, ref ~m, 1 - b)
    }
    for i in 0..16 {
        rewrite out_buf[2 * i] = cast(t[i] & 255, "uint8")
        rewrite out_buf[2 * i + 1] = cast((t[i] >> 8) & 255, "uint8")
    }
}

public fun par25519(ref a: int64[]) -> uint8 {
    set d: uint8[] = []
    for i in 0..32 {
        d.push(0u8)
    }
    pack25519(ref ~d, ref a)
    return d[0] & 1u8
}

public fun neq25519(ref a: int64[], ref b: int64[]) -> bool {
    set c: uint8[] = []
    set d: uint8[] = []
    for i in 0..32 {
        c.push(0u8)
        d.push(0u8)
    }
    pack25519(ref ~c, ref a)
    pack25519(ref ~d, ref b)
    set diff: uint8 = 0u8
    for i in 0..32 {
        rewrite diff = diff | (c[i] ^ d[i])
    }
    return diff != 0u8
}
