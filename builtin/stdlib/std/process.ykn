load .strings: trim

// decl core/process.rs start

cfun yukistd_process_last_error_code() -> int32
cfun yukistd_process_last_error_message(out_len: ptr<int64>) -> ptr<uint8>
cfun yukistd_process_default_shell(out_len: ptr<int64>) -> ptr<uint8>
cfun yukistd_process_exec(launcher_p: ptr<uint8>, launcher_len: int64, script_p: ptr<uint8>, script_len: int64) -> int32
cfun yukistd_process_run(prog_p: ptr<uint8>, prog_len: int64, args_p: ptr<string>, args_len: int64, out_status: ptr<int32>, out_signal: ptr<int32>, out_stdout: ptr<ptr<uint8>>, out_stdout_len: ptr<int64>, out_stderr: ptr<ptr<uint8>>, out_stderr_len: ptr<int64>) -> bool
cfun yukistd_process_run_shell(launcher_p: ptr<uint8>, launcher_len: int64, script_p: ptr<uint8>, script_len: int64, out_status: ptr<int32>, out_signal: ptr<int32>, out_stdout: ptr<ptr<uint8>>, out_stdout_len: ptr<int64>, out_stderr: ptr<ptr<uint8>>, out_stderr_len: ptr<int64>) -> bool
cfun yukistd_process_command_output(prog_p: ptr<uint8>, prog_len: int64, args_p: ptr<string>, args_len: int64, cwd_p: ptr<uint8>, cwd_len: int64, envs_k_p: ptr<string>, envs_v_p: ptr<string>, envs_len: int64, clear_env: bool, out_status: ptr<int32>, out_signal: ptr<int32>, out_stdout: ptr<ptr<uint8>>, out_stdout_len: ptr<int64>, out_stderr: ptr<ptr<uint8>>, out_stderr_len: ptr<int64>) -> bool
cfun yukistd_process_command_status(prog_p: ptr<uint8>, prog_len: int64, args_p: ptr<string>, args_len: int64, cwd_p: ptr<uint8>, cwd_len: int64, envs_k_p: ptr<string>, envs_v_p: ptr<string>, envs_len: int64, clear_env: bool, stdin_mode: int32, stdout_mode: int32, stderr_mode: int32, out_status: ptr<int32>, out_signal: ptr<int32>) -> bool
cfun yukistd_process_command_spawn(prog_p: ptr<uint8>, prog_len: int64, args_p: ptr<string>, args_len: int64, cwd_p: ptr<uint8>, cwd_len: int64, envs_k_p: ptr<string>, envs_v_p: ptr<string>, envs_len: int64, clear_env: bool, stdin_mode: int32, stdout_mode: int32, stderr_mode: int32, out_pid: ptr<int32>) -> int32
cfun yukistd_process_child_id(handle: int32) -> int32
cfun yukistd_process_child_wait(handle: int32, out_status: ptr<int32>, out_signal: ptr<int32>) -> bool
cfun yukistd_process_child_try_wait(handle: int32, out_has_exited: ptr<bool>, out_status: ptr<int32>, out_signal: ptr<int32>) -> bool
cfun yukistd_process_child_kill(handle: int32) -> bool
cfun yukistd_process_child_terminate(handle: int32) -> bool
cfun yukistd_process_child_wait_with_output(handle: int32, out_status: ptr<int32>, out_signal: ptr<int32>, out_stdout: ptr<ptr<uint8>>, out_stdout_len: ptr<int64>, out_stderr: ptr<ptr<uint8>>, out_stderr_len: ptr<int64>) -> bool
cfun yukistd_process_child_write_stdin(handle: int32, data_p: ptr<uint8>, data_len: int64, close_after: bool) -> bool
cfun yukistd_process_child_drop(handle: int32)
cfun yukistd_process_current_pid() -> int32
cfun yukistd_process_parent_pid() -> int32
cfun yukistd_process_current_exe(out_len: ptr<int64>) -> ptr<uint8>
cfun yukistd_process_current_dir(out_len: ptr<int64>) -> ptr<uint8>
cfun yukistd_process_set_current_dir(path_p: ptr<uint8>, path_len: int64) -> bool
cfun yukistd_process_get_env(name_p: ptr<uint8>, name_len: int64, out_len: ptr<int64>) -> ptr<uint8>
cfun yukistd_process_set_env(name_p: ptr<uint8>, name_len: int64, val_p: ptr<uint8>, val_len: int64) -> bool
cfun yukistd_process_remove_env(name_p: ptr<uint8>, name_len: int64) -> bool
