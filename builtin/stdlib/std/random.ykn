// decl core/random.rs start

cfun yukistd_random_system_entropy() -> uint64
cfun yukistd_random_system_bytes(buf: ptr<uint8>, len: int64)
cfun yukistd_random_global_u64() -> uint64
cfun yukistd_random_global_seed(seed: uint64)

// decl end

public struct RandomError {
    message: string
    code: int32
}

fun hex_char(v: uint8) -> string {
    if v < 10 {
        return cast(cast(48 + cast(v, "uint32"), "char"), "string")
    }
    return cast(cast(97 + cast(v - 10, "uint32"), "char"), "string")
}

public class Rng {
    state: uint64

    fun init(seed: uint64) {
        if seed == 0 { rewrite seed = 0x853c49e6748fea9bu64 }
        rewrite this.state = seed
    }

    fun next_u64() -> uint64 {
        rewrite this.state = this.state + 0x9e3779b97f4a7c15u64
        set z: uint64 = this.state
        rewrite z = (z ^ (z >> 30)) * 0xbf58476d1ce4e5b9u64
        rewrite z = (z ^ (z >> 27)) * 0x94d049bb133111ebu64
        return z ^ (z >> 31)
    }

    fun next_u32() -> uint32 {
        set v: uint64 = (this.next_u64() >> 32)
        return cast(v, "uint32")
    }

    fun next_i64() -> int64 { return cast(this.next_u64(), "int64") }
    fun next_i32() -> int32 { return cast(this.next_u32(), "int32") }
    fun next_bool() -> bool { return (this.next_u64() & 1u64) != 0 }

    fun next_float() -> float64 {
        set v: uint64 = (this.next_u64() >> 11)
        set f: float64 = cast(v, "float64")
        return f / 9007199254740992.0
    }

    fun next_float32() -> float32 {
        set v: uint32 = (this.next_u32() >> 8)
        set f: float32 = cast(v, "float32")
        set div: float32 = cast(16777216.0, "float32")
        return f / div
    }

    fun range_int(min: int64, max: int64) -> int64 {
        if min > max {
            panic(RandomError {
                message: "min cannot be greater than max in range_int",
                code: 1,
            })
        }
        if min == max { return min }
        set span = max - min + 1
        set u: uint64 = cast(span, "uint64")
        set raw = this.next_u64() % u
        return min + cast(raw, "int64")
    }

    fun range_float(min: float64, max: float64) -> float64 {
        if min > max {
            panic(RandomError {
                message: "min cannot be greater than max in range_float",
                code: 2,
            })
        }
        return min + this.next_float() * (max - min)
    }

    fun fill_bytes(buf: ptr<uint8>, len: int64) {
        set i: int64 = 0
        while i < len {
            set val = this.next_u64()
            set j: int64 = 0
            while j < 8 && i < len {
                set shift: uint64 = cast(j * 8, "uint64")
                set byte_val: uint8 = cast((val >> shift) & 0xffu64, "uint8")
                rewrite buf[i] = byte_val
                rewrite i = i + 1
                rewrite j = j + 1
            }
        }
    }
}

public fun rng_with_seed(seed: uint64) -> Rng { return init Rng(seed) }
public fun rng_new() -> Rng { return init Rng(yukistd_random_system_entropy()) }
public fun rand_u64() -> uint64 { return yukistd_random_global_u64() }

public fun rand_u32() -> uint32 {
    set v: uint64 = (yukistd_random_global_u64() >> 32)
    return cast(v, "uint32")
}

public fun rand_i64() -> int64 { return cast(rand_u64(), "int64") }
public fun rand_i32() -> int32 { return cast(rand_u32(), "int32") }
public fun rand_bool() -> bool { return (rand_u64() & 1u64) != 0 }

public fun rand_float() -> float64 {
    set v: uint64 = (rand_u64() >> 11)
    set f: float64 = cast(v, "float64")
    return f / 9007199254740992.0
}

public fun rand_float32() -> float32 {
    set v: uint32 = (rand_u32() >> 8)
    set f: float32 = cast(v, "float32")
    set div: float32 = cast(16777216.0, "float32")
    return f / div
}

public fun rand_int(min: int64, max: int64) -> int64 {
    if min > max {
        panic(RandomError {
            message: "min cannot be greater than max in rand_int",
            code: 1,
        })
    }
    if min == max { return min }
    set span = max - min + 1
    set u: uint64 = cast(span, "uint64")
    set raw = rand_u64() % u
    return min + cast(raw, "int64")
}

public fun rand_range(min: float64, max: float64) -> float64 {
    if min > max {
        panic(RandomError {
            message: "min cannot be greater than max in rand_range",
            code: 2,
        })
    }
    return min + rand_float() * (max - min)
}

public fun rand_bytes(buf: ptr<uint8>, len: int64) {
    yukistd_random_system_bytes(buf, len)
}

public fun rand_seed(seed: uint64) {
    yukistd_random_global_seed(seed)
}

public fun rand_choice_char(chars: string) -> char {
    if chars.len() == 0 {
        panic(RandomError {
            message: "chars string cannot be empty in rand_choice_char",
            code: 3,
        })
    }
    set idx = rand_int(0, chars.len() - 1)
    set b = chars[idx]
    set u: uint32 = cast(b, "uint32")
    return cast(u, "char")
}

public fun rand_uuid_v4() -> string {
    set res = ""
    set i: int64 = 0
    while i < 16 {
        set b: uint8 = cast(rand_u64() & 0xffu64, "uint8")
        if i == 6 { rewrite b = (b & 0x0fu8) | 0x40u8} 
        else { if i == 8 { rewrite b = (b & 0x3fu8) | 0x80u8 } }
        set hi = (b >> 4)
        set lo = (b & 0x0fu8)
        rewrite res = res + hex_char(hi) + hex_char(lo)
        if i == 3 || i == 5 || i == 7 || i == 9 { rewrite res = res + "-" }
        rewrite i = i + 1
    }
    return res
}

public fun rand_gaussian(mean: float64 = 0.0, std_dev: float64 = 1.0) -> float64 {
    set sum: float64 = 0.0
    set i: int32 = 0
    while i < 12 {
        rewrite sum = sum + rand_float()
        rewrite i = i + 1
    }
    set z = sum - 6.0
    return mean + z * std_dev
}
