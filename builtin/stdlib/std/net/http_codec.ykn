        rewrite buf = buf + chunk
    }
    set res = parse_response_str(buf)
    set complete_body = read_content_length_body_tls(ref stream, res.headers, res.body, max_body)
    rewrite res.body = complete_body
    return res
}

public fun parse_tls_response_with_limit(ref stream: TlsStream, max_body: int64) -> HttpResponse? {
    return parse_tls_response(ref stream, max_body)
}
