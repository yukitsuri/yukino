load .errors: TlsError, panic_last_tls_error
load .tcp: TcpStream

// decl core/net/tls.rs start

cfun yukistd_tls_client_connect(tcp_stream_id: uint64, host_p: ptr<uint8>, host_len: int64, insecure_skip_verify: bool) -> uint64
cfun yukistd_tls_server_accept(tcp_stream_id: uint64, cert_pem_p: ptr<uint8>, cert_pem_len: int64, key_pem_p: ptr<uint8>, key_pem_len: int64) -> uint64
cfun yukistd_tls_read(tls_id: uint64, buf_p: ptr<uint8>, max_len: int64) -> int64
cfun yukistd_tls_read_text(tls_id: uint64, max_len: int64, out_len: ptr<int64>) -> ptr<uint8>
cfun yukistd_tls_write(tls_id: uint64, buf_p: ptr<uint8>, len: int64) -> int64
cfun yukistd_tls_flush(tls_id: uint64) -> bool
cfun yukistd_tls_close(tls_id: uint64) -> bool

// decl end

public struct TlsServerConfig {
    cert_pem: string
    key_pem: string
}

public class TlsStream {
    id: uint64

    fun init(id: uint64) {
        rewrite this.id = id
    }

    fun read(max_len: int64 = 65536) -> string {
        set out_len: int64 = 0
        set p = yukistd_tls_read_text(this.id, max_len, ptr_of(out_len))
        if out_len < 0 || p == null {
            panic_last_tls_error("failed to read from tls stream", 6)
        }
        if out_len == 0 { return "" }
        return from_raw_parts(p, out_len)
    }

    fun read_bytes(buf: ptr<uint8>, max_len: int64) -> int64 {
        set n = yukistd_tls_read(this.id, buf, max_len)
        if n < 0 {
            panic_last_tls_error("failed to read bytes from tls stream", 6)
        }
        return n
    }

    fun write(data: string) -> int64 {
        set n = yukistd_tls_write(this.id, data.as_ptr(), data.len())
        if n < 0 {
            panic_last_tls_error("failed to write to tls stream", 6)
        }
        return n
    }

    fun write_bytes(buf: ptr<uint8>, len: int64) -> int64 {
        set n = yukistd_tls_write(this.id, buf, len)
        if n < 0 {
            panic_last_tls_error("failed to write bytes to tls stream", 6)
        }
        return n
    }

    fun flush() -> bool {
        set ok = yukistd_tls_flush(this.id)
        if !ok {
            panic_last_tls_error("failed to flush tls stream", 6)
        }
        return true
    }

    fun close() -> bool {
        if this.id == 0 { return true }
        set ok = yukistd_tls_close(this.id)
        rewrite this.id = 0
        return ok
    }
}

public fun tls_connect(ref tcp: TcpStream, hostname: string, skip_verify: bool = false) -> TlsStream {
    set handle = yukistd_tls_client_connect(tcp.id, hostname.as_ptr(), hostname.len(), skip_verify)
    if handle == 0 {
        panic_last_tls_error("failed to establish tls client session with " + hostname, 3)
    }
    return init TlsStream(handle)
}

public fun tls_accept(ref tcp: TcpStream, config: TlsServerConfig) -> TlsStream {
    set handle = yukistd_tls_server_accept(
        tcp.id,
        config.cert_pem.as_ptr(),
        config.cert_pem.len(),
        config.key_pem.as_ptr(),
        config.key_pem.len(),
    )
    if handle == 0 {
        panic_last_tls_error("failed to establish tls server session", 3)
    }
    return init TlsStream(handle)
}
