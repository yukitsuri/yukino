public fun winzip_aes_decrypt(password: string, aes_bits: int32, salt: bytes, data: bytes, check_val: uint16) -> bytes {
    if data.len() == 0 { return cast("", "bytes") }
    set out_len: int64 = 0
    set p = yukistd_pass_winzip_aes_decrypt(password.as_ptr(), password.len(), aes_bits, salt.as_ptr(), salt.len(), data.as_ptr(), data.len(), check_val, ptr_of(out_len))
    if out_len < 0 || p == null {
        panic_last_pass_error("winzip aes decryption failed", 204)
    }
    if out_len == 0 { return cast("", "bytes") }
    return from_raw_parts(p, out_len, out_len)
}

public struct WinZipAesResult {
    data: bytes
    check_value: uint16
}

public fun winzip_aes_encrypt(password: string, aes_bits: int32, salt: bytes, data: bytes) -> WinZipAesResult {
    set out_len: int64 = 0
    set raw_check: uint16 = 0
    set p = yukistd_pass_winzip_aes_encrypt(password.as_ptr(), password.len(), aes_bits, salt.as_ptr(), salt.len(), data.as_ptr(), data.len(), ptr_of(raw_check), ptr_of(out_len))
    if out_len < 0 || p == null {
        panic_last_pass_error("winzip aes encryption failed", 203)
    }
    set res_data: bytes = if out_len == 0 { cast("", "bytes") } else { from_raw_parts(p, out_len, out_len) }
    return WinZipAesResult {
        data: res_data,
        check_value: raw_check,
    }
}
