    set out_len: int64 = 0
    set p = yukistd_pass_aes_cbc_encrypt(key.as_ptr(), key.len(), iv.as_ptr(), iv.len(), data.as_ptr(), data.len(), ptr_of(out_len))
    if out_len < 0 || p == null {
        panic_last_pass_error("aes-cbc encryption failed", 203)
    }
    if out_len == 0 { return cast("", "bytes") }
