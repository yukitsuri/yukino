}

public fun aes_cbc_decrypt(key: bytes, iv: bytes, data: bytes) -> bytes {
    if data.len() == 0 { return cast("", "bytes") }
    set out_len: int64 = 0
    set p = yukistd_pass_aes_cbc_decrypt(key.as_ptr(), key.len(), iv.as_ptr(), iv.len(), data.as_ptr(), data.len(), ptr_of(out_len))
    if out_len < 0 || p == null {
        panic_last_pass_error("aes-cbc decryption failed", 203)
