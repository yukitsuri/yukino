load ..strings: slice, contains

// decl core/fs.rs start

cfun yukistd_fs_canonicalize(path_p: ptr<uint8>, path_len: int64, out_len: ptr<int64>) -> ptr<uint8>
cfun yukistd_fs_exists(path_p: ptr<uint8>, path_len: int64) -> bool
cfun yukistd_fs_is_file(path_p: ptr<uint8>, path_len: int64) -> bool
cfun yukistd_fs_is_dir(path_p: ptr<uint8>, path_len: int64) -> bool
cfun yukistd_fs_is_symlink(path_p: ptr<uint8>, path_len: int64) -> bool
cfun yukistd_fs_last_error_code() -> int32
cfun yukistd_fs_last_error_message(out_len: ptr<int64>) -> ptr<uint8>

// decl end

public struct FsError {
    message: string
    code: int32
}

#[cold, noreturn]
fun panic_last_fs_error(default_msg: string, default_code: int32) {
    set code = yukistd_fs_last_error_code()
    set out_len: int64 = 0
    set p = yukistd_fs_last_error_message(ptr_of(out_len))
    set msg = default_msg
    if out_len > 0 && p != null {
        rewrite msg = msg + ": " + from_raw_parts(p, out_len)
    }
    if code <= 0 { rewrite code = default_code }
    panic(FsError { message: msg, code: code })
}

#[inline_always]
public fun path_separator() -> string {
    set tgt = get_target!()
    if contains(tgt, "windows") {
        return "\\"
    }
    return "/"
}

#[inline_always, stable]
public fun path_is_separator(c: char) -> bool {
    return c == '/' || c == '\\'
}

#[inline]
public fun path_is_absolute(path: string) -> bool {
    set len = path.len()
    if len == 0 { return false }
    set b0 = path[0]
    if b0 == 47u8 || b0 == 92u8 { return true }
    if len >= 3 && path[1] == 58u8 {
        set b2 = path[2]
        if b2 == 47u8 || b2 == 92u8 {
            set is_upper = b0 >= 65u8 && b0 <= 90u8
            set is_lower = b0 >= 97u8 && b0 <= 122u8
            if is_upper || is_lower { return true }
        }
    }
    return false
}

#[inline_always]
public fun path_is_relative(path: string) -> bool {
    return !path_is_absolute(path)
}

#[inline]
fun is_path_sep_byte(b: uint8) -> bool {
    return b == 47u8 || b == 92u8
}

fun is_root_path(p: string) -> bool {
    set len = p.len()
    if len == 0 { return false }
    if len == 1 { return is_path_sep_byte(p[0]) }
    if len == 2 && is_path_sep_byte(p[0]) && is_path_sep_byte(p[1]) { return true }
    if len == 3 && p[1] == 58u8 && is_path_sep_byte(p[2]) {
        set b0 = p[0]
        set is_upper = b0 >= 65u8 && b0 <= 90u8
        set is_lower = b0 >= 97u8 && b0 <= 122u8
        return is_upper || is_lower
    }
    return false
}

public fun path_join(...parts: string) -> string {
    set count = parts.len()
    if count == 0 { return "" }
    set res = ""
    for i in 0..count {
        set part = parts[i]
        if part.len() == 0 { continue }
        if path_is_absolute(part.cp()) {
            rewrite res = part
            continue
        }
        if res.len() == 0 {
            rewrite res = part
            continue
        }
        set res_end = res.len()
        while res_end > 0 && is_path_sep_byte(res[res_end - 1]) && !is_root_path(slice(res, 0, res_end)) {
            rewrite res_end = res_end - 1
        }
        if res_end < res.len() {
            rewrite res = slice(res, 0, res_end)
        }
        set part_start: int64 = 0
        set part_len = part.len()
        while part_start < part_len && is_path_sep_byte(part[part_start]) {
            rewrite part_start = part_start + 1
        }
        if part_start + 1 < part_len && part[part_start] == 46u8 && is_path_sep_byte(part[part_start + 1]) {
            rewrite part_start = part_start + 2
            while part_start < part_len && is_path_sep_byte(part[part_start]) {
                rewrite part_start = part_start + 1
            }
        }
        if part_start >= part_len { continue }
        set clean_part: string = if part_start > 0 { slice(part, part_start, part_len) } else { part }
        if is_path_sep_byte(res[res.len() - 1]) {
            rewrite res = res + clean_part
        } else {
            rewrite res = res + "/" + clean_part
        }
    }
    return res
}

public fun path_file_name(path: string) -> string {
    set len = path.len()
    if len == 0 { return "" }
    set end_idx = len
    while end_idx > 0 && (path[end_idx - 1] == 47u8 || path[end_idx - 1] == 92u8) {
        rewrite end_idx = end_idx - 1
    }
    if end_idx == 0 {
        if len > 0 { return "/" }
        return ""
    }
    set i = end_idx
    while i > 0 {
        set b = path[i - 1]
        if b == 47u8 || b == 92u8 { return slice(path, i, end_idx) }
        rewrite i = i - 1
    }
    return slice(path, 0, end_idx)
}

public fun path_parent(path: string) -> string {
    set len = path.len()
    if len == 0 { return "" }
    set end_idx = len
    while end_idx > 0 && (path[end_idx - 1] == 47u8 || path[end_idx - 1] == 92u8) {
        rewrite end_idx = end_idx - 1
    }
    if end_idx == 0 { return "/" }
    set i = end_idx
    while i > 0 {
        set b = path[i - 1]
        if b == 47u8 || b == 92u8 {
            if i - 1 == 0 { return "/" }
            return slice(path, 0, i - 1)
        }
        rewrite i = i - 1
    }
    return ""
}

public fun path_file_stem(path: string) -> string {
    set name = path_file_name(path)
    set len = name.len()
    if len == 0 { return "" }
    set i = len
    while i > 0 {
        if name[i - 1] == 46u8 { // '.'
            if i - 1 == 0 { return name }
            return slice(name, 0, i - 1)
        }
        rewrite i = i - 1
    }
    return name
}

public fun path_extension(path: string) -> string {
    set name = path_file_name(path)
    set len = name.len()
    if len == 0 { return "" }
    set i = len
    while i > 0 {
        if name[i - 1] == 46u8 { // '.'
            if i - 1 == 0 { return "" }
            return slice(name, i, len)
        }
        rewrite i = i - 1
    }
    return ""
}

public fun path_has_extension(path: string) -> bool {
    return path_extension(path).len() > 0
}

public fun path_with_extension(path: string, new_ext: string) -> string {
    set stem = path_file_stem(path.cp())
    set par = path_parent(path)
    set new_name = stem
    if new_ext.len() > 0 {
        rewrite new_name = new_name + "." + new_ext
    }
    if par.len() > 0 {
        return path_join(par, new_name)
    }
    return new_name
}

public fun path_canonicalize(path: string) -> string {
    set out_len: int64 = 0
    set p = yukistd_fs_canonicalize(path.as_ptr(), path.len(), ptr_of(out_len))
    if out_len < 0 || p == null {
        panic_last_fs_error("failed to canonicalize path '" + path + "'", 1)
    }
    if out_len == 0 { return "" }
    return from_raw_parts(p, out_len)
}

public fun path_exists(path: string) -> bool {
    return yukistd_fs_exists(path.as_ptr(), path.len())
}

public fun path_is_file(path: string) -> bool {
    return yukistd_fs_is_file(path.as_ptr(), path.len())
}

public fun path_is_dir(path: string) -> bool {
    return yukistd_fs_is_dir(path.as_ptr(), path.len())
}

public fun path_is_symlink(path: string) -> bool {
    return yukistd_fs_is_symlink(path.as_ptr(), path.len())
}


