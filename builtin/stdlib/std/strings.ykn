cfun yukistd_str_utflen(ptr: ptr<uint8>, len: int64) -> int64
cfun yukistd_str_slice(ptr: ptr<uint8>, len: int64, start: int64, end: int64, out_len: ptr<int64>) -> ptr<uint8>
cfun yukistd_str_eq(p1: ptr<uint8>, l1: int64, p2: ptr<uint8>, l2: int64) -> bool
cfun yukistd_str_cmp(p1: ptr<uint8>, l1: int64, p2: ptr<uint8>, l2: int64) -> int32
cfun yukistd_str_starts_with(p1: ptr<uint8>, l1: int64, p2: ptr<uint8>, l2: int64) -> bool
cfun yukistd_str_ends_with(p1: ptr<uint8>, l1: int64, p2: ptr<uint8>, l2: int64) -> bool
cfun yukistd_str_contains(p1: ptr<uint8>, l1: int64, p2: ptr<uint8>, l2: int64) -> bool
cfun yukistd_str_index_of(p1: ptr<uint8>, l1: int64, p2: ptr<uint8>, l2: int64, from_idx: int64) -> int64
cfun yukistd_str_last_index_of(p1: ptr<uint8>, l1: int64, p2: ptr<uint8>, l2: int64) -> int64
cfun yukistd_str_count(p1: ptr<uint8>, l1: int64, p2: ptr<uint8>, l2: int64) -> int64
cfun yukistd_str_trim(p: ptr<uint8>, len: int64, mode: int32, out_len: ptr<int64>) -> ptr<uint8>
cfun yukistd_str_upper(p: ptr<uint8>, len: int64, out_len: ptr<int64>) -> ptr<uint8>
cfun yukistd_str_lower(p: ptr<uint8>, len: int64, out_len: ptr<int64>) -> ptr<uint8>
cfun yukistd_str_replace(p: ptr<uint8>, len: int64, from_p: ptr<uint8>, from_len: int64, to_p: ptr<uint8>, to_len: int64, out_len: ptr<int64>) -> ptr<uint8>
cfun yukistd_str_repeat(p: ptr<uint8>, len: int64, count: int64, out_len: ptr<int64>) -> ptr<uint8>
cfun yukistd_str_reverse(p: ptr<uint8>, len: int64, out_len: ptr<int64>) -> ptr<uint8>
cfun yukistd_str_pad_start(p: ptr<uint8>, len: int64, target_len: int64, pad_p: ptr<uint8>, pad_len: int64, out_len: ptr<int64>) -> ptr<uint8>
cfun yukistd_str_pad_end(p: ptr<uint8>, len: int64, target_len: int64, pad_p: ptr<uint8>, pad_len: int64, out_len: ptr<int64>) -> ptr<uint8>
cfun yukistd_str_to_i64(p: ptr<uint8>, len: int64, default_val: int64) -> int64
cfun yukistd_str_to_f64(p: ptr<uint8>, len: int64, default_val: float64) -> float64
cfun yukistd_str_parse_i64(p: ptr<uint8>, len: int64, out_val: ptr<int64>) -> bool
cfun yukistd_str_parse_f64(p: ptr<uint8>, len: int64, out_val: ptr<float64>) -> bool
cfun yukistd_str_split(p: ptr<uint8>, len: int64, delim_p: ptr<uint8>, delim_len: int64, out_len: ptr<int64>) -> ptr<string>
cfun yukistd_str_lines(p: ptr<uint8>, len: int64, out_len: ptr<int64>) -> ptr<string>
cfun yukistd_str_join(items_p: ptr<string>, items_len: int64, delim_p: ptr<uint8>, delim_len: int64, out_len: ptr<int64>) -> ptr<uint8>

// decl end

public struct StringIndexError {
    message: string
    code: int32
}

public struct StringParseError {
    message: string
    code: int32
}

#[inline]
public fun utflen(s: string) -> int64 {
    return yukistd_str_utflen(s.as_ptr(), s.len())
}

#[inline_always]
public fun is_empty(s: string) -> bool {
    return s.len() == 0
}

#[inline]
public fun byte_at(s: string, index: int64) -> uint8 {
    if index < 0 || index >= s.len() {
        panic(StringIndexError {
            message: "string index out of bounds",
            code: 1,
        })
    }
    return s[index]
}

#[inline]
public fun char_at(s: string, index: int64) -> char {
    set b = byte_at(s, index)
    set u: uint32 = cast(b, "uint32")
    return cast(u, "char")
}

#[inline]
public fun slice(s: string, start: int64, end: int64) -> string {
    set out_len: int64 = 0
    set p = yukistd_str_slice(s.as_ptr(), s.len(), start, end, ptr_of(out_len))
    if out_len <= 0 { return "" }
    return from_raw_parts(p, out_len)
}

#[inline]
public fun eq(a: string, b: string) -> bool {
    return yukistd_str_eq(a.as_ptr(), a.len(), b.as_ptr(), b.len())
}

#[inline_always]
public fun ne(a: string, b: string) -> bool {
    return !yukistd_str_eq(a.as_ptr(), a.len(), b.as_ptr(), b.len())
}

#[inline]
public fun compare(a: string, b: string) -> int32 {
    return yukistd_str_cmp(a.as_ptr(), a.len(), b.as_ptr(), b.len())
}

// Empty prefix returns null
#[inline]
public fun starts_with(s: string, prefix: string) -> bool? {
    if prefix.len() == 0 { return null }
    return yukistd_str_starts_with(s.as_ptr(), s.len(), prefix.as_ptr(), prefix.len())
}

// Empty suffix returns null
#[inline]
public fun ends_with(s: string, suffix: string) -> bool? {
    if suffix.len() == 0 { return null }
    return yukistd_str_ends_with(s.as_ptr(), s.len(), suffix.as_ptr(), suffix.len())
}

#[inline]
public fun contains(s: string, sub: string) -> bool {
    return yukistd_str_contains(s.as_ptr(), s.len(), sub.as_ptr(), sub.len())
}

// Returns null when substring is not found
#[inline]
public fun index_of(s: string, sub: string) -> int64? {
    set idx = yukistd_str_index_of(s.as_ptr(), s.len(), sub.as_ptr(), sub.len(), 0)
    if idx < 0 { return null }
    return idx
}

// Returns null when substring is not found at or after from_idx
#[inline]
public fun index_of_from(s: string, sub: string, from_idx: int64) -> int64? {
    set idx = yukistd_str_index_of(s.as_ptr(), s.len(), sub.as_ptr(), sub.len(), from_idx)
    if idx < 0 { return null }
    return idx
}

// Returns null when substring is not found
#[inline]
public fun last_index_of(s: string, sub: string) -> int64? {
    set idx = yukistd_str_last_index_of(s.as_ptr(), s.len(), sub.as_ptr(), sub.len())
    if idx < 0 { return null }
    return idx
}

#[inline]
public fun count(s: string, sub: string) -> int64 {
    return yukistd_str_count(s.as_ptr(), s.len(), sub.as_ptr(), sub.len())
}

#[inline]
public fun trim(s: string) -> string {
    set out_len: int64 = 0
    set p = yukistd_str_trim(s.as_ptr(), s.len(), 0, ptr_of(out_len))
    if out_len <= 0 { return "" }
    return from_raw_parts(p, out_len)
}

#[inline]
public fun trim_start(s: string) -> string {
    set out_len: int64 = 0
    set p = yukistd_str_trim(s.as_ptr(), s.len(), 1, ptr_of(out_len))
    if out_len <= 0 { return "" }
    return from_raw_parts(p, out_len)
}

#[inline]
public fun trim_end(s: string) -> string {
    set out_len: int64 = 0
    set p = yukistd_str_trim(s.as_ptr(), s.len(), 2, ptr_of(out_len))
    if out_len <= 0 { return "" }
    return from_raw_parts(p, out_len)
}

#[inline]
public fun upper(s: string) -> string {
    set out_len: int64 = 0
    set p = yukistd_str_upper(s.as_ptr(), s.len(), ptr_of(out_len))
    if out_len <= 0 { return "" }
    return from_raw_parts(p, out_len)
}

#[inline]
public fun lower(s: string) -> string {
    set out_len: int64 = 0
    set p = yukistd_str_lower(s.as_ptr(), s.len(), ptr_of(out_len))
    if out_len <= 0 { return "" }
    return from_raw_parts(p, out_len)
}

public fun replace(s: string, from_sub: string, to_sub: string) -> string {
    set out_len: int64 = 0
    set p = yukistd_str_replace(s.as_ptr(), s.len(), from_sub.as_ptr(), from_sub.len(), to_sub.as_ptr(), to_sub.len(), ptr_of(out_len))
    if out_len <= 0 { return "" }
    return from_raw_parts(p, out_len)
}

public fun repeat(s: string, count_num: int64) -> string {
    if count_num <= 0 { return "" }
    set out_len: int64 = 0
    set p = yukistd_str_repeat(s.as_ptr(), s.len(), count_num, ptr_of(out_len))
    if out_len <= 0 { return "" }
    return from_raw_parts(p, out_len)
}

public fun reverse(s: string) -> string {
    set out_len: int64 = 0
    set p = yukistd_str_reverse(s.as_ptr(), s.len(), ptr_of(out_len))
    if out_len <= 0 { return "" }
    return from_raw_parts(p, out_len)
}

public fun pad_start(s: string, target_len: int64, pad: string = " ") -> string {
    set out_len: int64 = 0
    set p = yukistd_str_pad_start(s.as_ptr(), s.len(), target_len, pad.as_ptr(), pad.len(), ptr_of(out_len))
    if out_len <= 0 { return "" }
    return from_raw_parts(p, out_len)
}

public fun pad_end(s: string, target_len: int64, pad: string = " ") -> string {
    set out_len: int64 = 0
    set p = yukistd_str_pad_end(s.as_ptr(), s.len(), target_len, pad.as_ptr(), pad.len(), ptr_of(out_len))
    if out_len <= 0 { return "" }
    return from_raw_parts(p, out_len)
}

public fun split(s: string, delimiter: string) -> string[] {
    set count: int64 = 0
    set p = yukistd_str_split(s.as_ptr(), s.len(), delimiter.as_ptr(), delimiter.len(), ptr_of(count))
    if count <= 0 {
        set empty_p: ptr<string> = null
        return from_raw_parts(empty_p, 0, 0)
    }
    return from_raw_parts(p, count, count)
}

public fun lines(s: string) -> string[] {
    set count: int64 = 0
    set p = yukistd_str_lines(s.as_ptr(), s.len(), ptr_of(count))
    if count <= 0 {
        set empty_p: ptr<string> = null
        return from_raw_parts(empty_p, 0, 0)
    }
    return from_raw_parts(p, count, count)
}

public fun str_join(items: string[], delimiter: string = "") -> string {
    if items.len() == 0 { return "" }
    set out_len: int64 = 0
    set p = yukistd_str_join(items.as_ptr(), items.len(), delimiter.as_ptr(), delimiter.len(), ptr_of(out_len))
    if out_len <= 0 { return "" }
    return from_raw_parts(p, out_len)
}

public fun parse_int(s: string) -> int64? {
    set out: int64 = 0
    if !yukistd_str_parse_i64(s.as_ptr(), s.len(), ptr_of(out)) {
        return null
    }
    return out
}

public fun parse_float(s: string) -> float64? {
    set out: float64 = 0.0
    if !yukistd_str_parse_f64(s.as_ptr(), s.len(), ptr_of(out)) {
        return null
    }
    return out
}

public fun to_int64(s: string) -> int64 {
    set out: int64 = 0
    if !yukistd_str_parse_i64(s.as_ptr(), s.len(), ptr_of(out)) {
        panic(StringParseError {
            message: "cannot parse string as int64",
            code: 10,
        })
    }
    return out
}

public fun to_float64(s: string) -> float64 {
    set out: float64 = 0.0
    if !yukistd_str_parse_f64(s.as_ptr(), s.len(), ptr_of(out)) {
        panic(StringParseError {
            message: "cannot parse string as float64",
            code: 11,
        })
    }
    return out
}

public fun to_bool(s: string) -> bool {
    set out_len: int64 = 0
    set p: ptr<uint8> = yukistd_str_trim(s.as_ptr(), s.len(), 0, ptr_of(out_len))
    
    if yukistd_str_eq(p, out_len, "true".as_ptr(), 4) { return true }
    if yukistd_str_eq(p, out_len, "1".as_ptr(), 1) { return true }
    if yukistd_str_eq(p, out_len, "yes".as_ptr(), 3) { return true }
    if yukistd_str_eq(p, out_len, "on".as_ptr(), 2) { return true }

    if yukistd_str_eq(p, out_len, "false".as_ptr(), 5) { return false }
    if yukistd_str_eq(p, out_len, "0".as_ptr(), 1) { return false }
    if yukistd_str_eq(p, out_len, "no".as_ptr(), 2) { return false }
    if yukistd_str_eq(p, out_len, "off".as_ptr(), 3) { return false }

    panic(StringParseError {
        message: "cannot parse string as bool",
        code: 12,
    })
}

public fun to_string(s: string) -> string {
    return s.cp()
}
