load ..strings: slice, parse_int, parse_float, trim
load .tokens: *

fun hex_val(b: uint8) -> int64 {
    if b >= 48 && b <= 57 { return cast(b - 48, "int64") }
    if b >= 65 && b <= 70 { return cast(b - 65 + 10, "int64") }
    if b >= 97 && b <= 102 { return cast(b - 97 + 10, "int64") }
    return -1
}

public class YamlScanner {
    public text: string
    public len: int64
    public pos: int64
    public line: int64
    public col: int64

    public indent_stack: int64[]
    public in_flow: int64
    public at_line_start: bool

    public queue_kind: int32[]
    public queue_str: string[]
    public queue_num: float64[]
    public queue_bool: bool[]
    public queue_pos: int64

    public curr_kind: int32
    public curr_str: string
    public curr_num: float64
    public curr_bool: bool
    public curr_line: int64
    public curr_col: int64
    public curr_offset: int64

    public error_msg: string
    public has_error: bool

    public fun init(text: string) {
        rewrite this.text = text
        rewrite this.len = text.len()
        rewrite this.pos = 0
        rewrite this.line = 1
        rewrite this.col = 1

        rewrite this.indent_stack = [0]
        rewrite this.in_flow = 0
        rewrite this.at_line_start = true

        rewrite this.queue_kind = []
        rewrite this.queue_str = []
        rewrite this.queue_num = []
        rewrite this.queue_bool = []
        rewrite this.queue_pos = 0

        rewrite this.curr_kind = YAML_TOK_EOF
        rewrite this.curr_str = ""
        rewrite this.curr_num = 0.0
        rewrite this.curr_bool = false
        rewrite this.curr_line = 1
        rewrite this.curr_col = 1
        rewrite this.curr_offset = 0

        rewrite this.error_msg = ""
        rewrite this.has_error = false
    }

    public fun set_err(msg: string) -> int32 {
        rewrite this.has_error = true
        rewrite this.error_msg = msg
        rewrite this.curr_kind = YAML_TOK_ERROR
        return YAML_TOK_ERROR
    }

    fun enqueue(kind: int32, s: string, num: float64, b: bool) {
        this.queue_kind.push(kind)
        this.queue_str.push(s)
        this.queue_num.push(num)
        this.queue_bool.push(b)
    }

    fun is_digit(b: uint8) -> bool {
        return b >= 48 && b <= 57
    }

    fun peek_char(offset: int64) -> uint8 {
        if this.pos + offset < this.len {
            return this.text[this.pos + offset]
        }
        return cast(0, "uint8")
    }

    public fun scan() -> int32 {
        if this.queue_pos < this.queue_kind.len() {
            rewrite this.curr_kind = this.queue_kind[this.queue_pos]
            rewrite this.curr_str = this.queue_str[this.queue_pos]
            rewrite this.curr_num = this.queue_num[this.queue_pos]
            rewrite this.curr_bool = this.queue_bool[this.queue_pos]
            rewrite this.queue_pos = this.queue_pos + 1
            return this.curr_kind
        }

        rewrite this.queue_kind = []
        rewrite this.queue_str = []
        rewrite this.queue_num = []
        rewrite this.queue_bool = []
        rewrite this.queue_pos = 0

        this.scan_tokens()

        if this.queue_kind.len() > 0 {
            rewrite this.curr_kind = this.queue_kind[0]
            rewrite this.curr_str = this.queue_str[0]
            rewrite this.curr_num = this.queue_num[0]
            rewrite this.curr_bool = this.queue_bool[0]
            rewrite this.queue_pos = 1
            return this.curr_kind
        }

        rewrite this.curr_kind = YAML_TOK_EOF
        rewrite this.curr_str = ""
        rewrite this.curr_num = 0.0
        rewrite this.curr_bool = false
        return YAML_TOK_EOF
    }

    fun scan_tokens() {
        while this.pos < this.len {
            // Line-start indentation check
            if this.at_line_start {
                set indent: int64 = 0
                set start_p: int64 = this.pos
                while start_p < this.len && this.text[start_p] == 32 {
                    rewrite start_p = start_p + 1
                    rewrite indent = indent + 1
                }

                // Check if blank line or comment line
                if start_p >= this.len || this.text[start_p] == 10 || this.text[start_p] == 13 || this.text[start_p] == 35 {
                    rewrite this.pos = start_p
                    if this.pos < this.len && this.text[this.pos] == 35 { // comment
                        while this.pos < this.len && this.text[this.pos] != 10 {
                            rewrite this.pos = this.pos + 1
                        }
                    }
                    if this.pos < this.len && this.text[this.pos] == 13 {
                        rewrite this.pos = this.pos + 1
                    }
                    if this.pos < this.len && this.text[this.pos] == 10 {
                        rewrite this.pos = this.pos + 1
                        rewrite this.line = this.line + 1
                        rewrite this.col = 1
                    }
                    continue
                }

                rewrite this.pos = start_p
                rewrite this.col = indent + 1
                rewrite this.at_line_start = false

                if this.in_flow == 0 {
                    set top_indent: int64 = this.indent_stack[this.indent_stack.len() - 1]
                    if indent > top_indent {
                        this.indent_stack.push(indent)
                        this.enqueue(YAML_TOK_INDENT, "", 0.0, false)
                    } elif indent < top_indent {
                        while this.indent_stack.len() > 1 && indent < this.indent_stack[this.indent_stack.len() - 1] {
                            set _: int64? = this.indent_stack.pop()
                            this.enqueue(YAML_TOK_DEDENT, "", 0.0, false)
                        }
                    }
                }

                if this.queue_kind.len() > 0 {
                    return
                }
            }

            // Skip spaces and tabs
            while this.pos < this.len && (this.text[this.pos] == 32 || this.text[this.pos] == 9 || this.text[this.pos] == 13) {
                rewrite this.pos = this.pos + 1
                rewrite this.col = this.col + 1
            }

            if this.pos >= this.len {
                break
            }

            set b: uint8 = this.text[this.pos]

            // Comment
            if b == 35 {
                while this.pos < this.len && this.text[this.pos] != 10 {
                    rewrite this.pos = this.pos + 1
                }
                continue
            }

            // Newline
            if b == 10 {
                rewrite this.pos = this.pos + 1
                rewrite this.line = this.line + 1
                rewrite this.col = 1
                rewrite this.at_line_start = true
                this.enqueue(YAML_TOK_NEWLINE, "\n", 0.0, false)
                return
            }

            // Directives / Document markers: --- or ...
            if b == 45 || b == 46 {
                if this.pos + 2 < this.len {
                    if b == 45 && this.text[this.pos + 1] == 45 && this.text[this.pos + 2] == 45 {
                        set next_b: uint8 = this.peek_char(3)
                        if next_b == 32 || next_b == 10 || next_b == 13 || next_b == 0 {
                            rewrite this.pos = this.pos + 3
                            rewrite this.col = this.col + 3
                            this.enqueue(YAML_TOK_DOC_START, "---", 0.0, false)
                            return
                        }
                    }
                    if b == 46 && this.text[this.pos + 1] == 46 && this.text[this.pos + 2] == 46 {
                        set next_b: uint8 = this.peek_char(3)
                        if next_b == 32 || next_b == 10 || next_b == 13 || next_b == 0 {
                            rewrite this.pos = this.pos + 3
                            rewrite this.col = this.col + 3
                            this.enqueue(YAML_TOK_DOC_END, "...", 0.0, false)
                            return
                        }
                    }
                }
            }

            // List item: - followed by space or newline
            if b == 45 { // '-'
                set next_b: uint8 = this.peek_char(1)
                if next_b == 32 || next_b == 10 || next_b == 13 || next_b == 0 {
                    rewrite this.pos = this.pos + 1
                    rewrite this.col = this.col + 1
                    this.enqueue(YAML_TOK_DASH, "-", 0.0, false)
                    return
                }
            }

            // Key separator: : followed by space, newline, or EOF
            if b == 58 { // ':'
                set next_b: uint8 = this.peek_char(1)
                if next_b == 32 || next_b == 9 || next_b == 10 || next_b == 13 || next_b == 0 || (this.in_flow > 0 && next_b == 44) {
                    rewrite this.pos = this.pos + 1
                    rewrite this.col = this.col + 1
                    this.enqueue(YAML_TOK_COLON, ":", 0.0, false)
                    return
                }
            }

            // Flow structures
            if b == 91 { // '['
                rewrite this.pos = this.pos + 1
                rewrite this.col = this.col + 1
                rewrite this.in_flow = this.in_flow + 1
                this.enqueue(YAML_TOK_LBRACKET, "[", 0.0, false)
                return
            }
            if b == 93 { // ']'
                rewrite this.pos = this.pos + 1
                rewrite this.col = this.col + 1
                if this.in_flow > 0 { rewrite this.in_flow = this.in_flow - 1 }
                this.enqueue(YAML_TOK_RBRACKET, "]", 0.0, false)
                return
            }
            if b == 123 { // '{'
                rewrite this.pos = this.pos + 1
                rewrite this.col = this.col + 1
                rewrite this.in_flow = this.in_flow + 1
                this.enqueue(YAML_TOK_LBRACE, "{", 0.0, false)
                return
            }
            if b == 125 { // '}'
                rewrite this.pos = this.pos + 1
                rewrite this.col = this.col + 1
                if this.in_flow > 0 { rewrite this.in_flow = this.in_flow - 1 }
                this.enqueue(YAML_TOK_RBRACE, "}", 0.0, false)
                return
            }
            if b == 44 { // ','
                rewrite this.pos = this.pos + 1
                rewrite this.col = this.col + 1
                this.enqueue(YAML_TOK_COMMA, ",", 0.0, false)
                return
            }

            // Block scalars: | or >
            if b == 124 || b == 62 {
                set next_b: uint8 = this.peek_char(1)
                if next_b == 32 || next_b == 10 || next_b == 13 || next_b == 43 || next_b == 45 {
                    this.scan_block_scalar(b == 124)
                    return
                }
            }

            // Double quoted string: "..."
            if b == 34 {
                this.scan_double_quoted_string()
                return
            }

            // Single quoted string: '...'
            if b == 39 {
                this.scan_single_quoted_string()
                return
            }

            // Plain scalar: runs until terminator (: , [ ] { } # \n)
            this.scan_plain_scalar()
            return
        }

        // EOF: unwind remaining indents
        if this.indent_stack.len() > 1 {
            while this.indent_stack.len() > 1 {
                set _: int64? = this.indent_stack.pop()
                this.enqueue(YAML_TOK_DEDENT, "", 0.0, false)
            }
        }
    }

    fun scan_double_quoted_string() {
        rewrite this.pos = this.pos + 1
        rewrite this.col = this.col + 1
        set res: string = ""
        set chunk_start: int64 = this.pos

        while this.pos < this.len {
            set b: uint8 = this.text[this.pos]
            if b == 34 { // '"'
                if this.pos > chunk_start {
                    rewrite res = res + slice(this.text, chunk_start, this.pos)
                }
                rewrite this.pos = this.pos + 1
                rewrite this.col = this.col + 1
                this.enqueue(YAML_TOK_STRING, res, 0.0, false)
                return
            }
            if b == 92 { // '\'
                if this.pos > chunk_start {
                    rewrite res = res + slice(this.text, chunk_start, this.pos)
                }
                rewrite this.pos = this.pos + 1
                rewrite this.col = this.col + 1
                if this.pos >= this.len {
                    this.set_err("unexpected end of string escape")
                    return
                }
                set esc: uint8 = this.text[this.pos]
                rewrite this.pos = this.pos + 1
                rewrite this.col = this.col + 1
                if esc == 34 { rewrite res = res + "\"" }
                elif esc == 92 { rewrite res = res + "\\" }
                elif esc == 110 { rewrite res = res + "\n" }
                elif esc == 114 { rewrite res = res + "\r" }
                elif esc == 116 { rewrite res = res + "\t" }
                elif esc == 48 { set ch: char = cast(0, "char"); rewrite res = res + cast(ch, "string") }
                elif esc == 120 { // \xHH
                    if this.pos + 2 > this.len { this.set_err("unexpected end of hex escape"); return }
                    set h0: int64 = hex_val(this.text[this.pos])
                    set h1: int64 = hex_val(this.text[this.pos + 1])
                    rewrite this.pos = this.pos + 2
                    rewrite this.col = this.col + 2
                    set cp: int64 = (h0 << 4) | h1
                    set ch: char = cast(cp, "char")
                    rewrite res = res + cast(ch, "string")
                }
                elif esc == 117 { // \uXXXX
                    if this.pos + 4 > this.len { this.set_err("unexpected end of unicode escape"); return }
                    set h0: int64 = hex_val(this.text[this.pos])
                    set h1: int64 = hex_val(this.text[this.pos + 1])
                    set h2: int64 = hex_val(this.text[this.pos + 2])
                    set h3: int64 = hex_val(this.text[this.pos + 3])
                    rewrite this.pos = this.pos + 4
                    rewrite this.col = this.col + 4
                    set cp: int64 = (h0 << 12) | (h1 << 8) | (h2 << 4) | h3
                    set ch: char = cast(cp, "char")
                    rewrite res = res + cast(ch, "string")
                } else {
                    rewrite res = res + cast(cast(esc, "char"), "string")
                }
                rewrite chunk_start = this.pos
            } elif b == 10 {
                rewrite this.pos = this.pos + 1
                rewrite this.line = this.line + 1
                rewrite this.col = 1
            } else {
                rewrite this.pos = this.pos + 1
                rewrite this.col = this.col + 1
            }
        }
        this.set_err("unterminated double-quoted string")
    }

    fun scan_single_quoted_string() {
        rewrite this.pos = this.pos + 1
        rewrite this.col = this.col + 1
        set res: string = ""
        set chunk_start: int64 = this.pos

        while this.pos < this.len {
            set b: uint8 = this.text[this.pos]
            if b == 39 { // '\''
                if this.pos + 1 < this.len && this.text[this.pos + 1] == 39 { // '' escape
                    if this.pos > chunk_start {
                        rewrite res = res + slice(this.text, chunk_start, this.pos)
                    }
                    rewrite res = res + "'"
                    rewrite this.pos = this.pos + 2
                    rewrite this.col = this.col + 2
                    rewrite chunk_start = this.pos
                    continue
                }
                if this.pos > chunk_start {
                    rewrite res = res + slice(this.text, chunk_start, this.pos)
                }
                rewrite this.pos = this.pos + 1
                rewrite this.col = this.col + 1
                this.enqueue(YAML_TOK_STRING, res, 0.0, false)
                return
            }
            if b == 10 {
                rewrite this.pos = this.pos + 1
                rewrite this.line = this.line + 1
                rewrite this.col = 1
            } else {
                rewrite this.pos = this.pos + 1
                rewrite this.col = this.col + 1
            }
        }
        this.set_err("unterminated single-quoted string")
    }

    fun scan_block_scalar(is_literal: bool) {
        // Skip header '|' or '>' and optional modifier
        while this.pos < this.len && this.text[this.pos] != 10 {
            rewrite this.pos = this.pos + 1
        }
        if this.pos < this.len && this.text[this.pos] == 10 {
            rewrite this.pos = this.pos + 1
            rewrite this.line = this.line + 1
            rewrite this.col = 1
        }

        set parent_indent: int64 = this.indent_stack[this.indent_stack.len() - 1]
        set block_indent: int64 = -1
        set res: string = ""
        set is_first_line: bool = true

        while this.pos < this.len {
            // Count leading spaces of line
            set start_p: int64 = this.pos
            set line_indent: int64 = 0
            while start_p < this.len && this.text[start_p] == 32 {
                rewrite start_p = start_p + 1
                rewrite line_indent = line_indent + 1
            }

            // If empty line in block
            if start_p < this.len && (this.text[start_p] == 10 || this.text[start_p] == 13) {
                if !is_first_line { rewrite res = res + "\n" }
                rewrite this.pos = start_p
                if this.pos < this.len && this.text[this.pos] == 13 { rewrite this.pos = this.pos + 1 }
                if this.pos < this.len && this.text[this.pos] == 10 {
                    rewrite this.pos = this.pos + 1
                    rewrite this.line = this.line + 1
                    rewrite this.col = 1
                }
                rewrite is_first_line = false
                continue
            }

            if block_indent < 0 {
                if line_indent <= parent_indent {
                    // No block content indented
                    break
                }
                rewrite block_indent = line_indent
            } else {
                if line_indent < block_indent {
                    // End of block scalar
                    break
                }
            }

            // Read the rest of line
            rewrite this.pos = this.pos + block_indent
            set line_content_start: int64 = this.pos
            while this.pos < this.len && this.text[this.pos] != 10 && this.text[this.pos] != 13 {
                rewrite this.pos = this.pos + 1
            }
            set line_str: string = slice(this.text, line_content_start, this.pos)

            if is_first_line {
                rewrite res = line_str
                rewrite is_first_line = false
            } else {
                if is_literal {
                    rewrite res = res + "\n" + line_str
                } else {
                    rewrite res = res + " " + line_str
                }
            }

            if this.pos < this.len && this.text[this.pos] == 13 { rewrite this.pos = this.pos + 1 }
            if this.pos < this.len && this.text[this.pos] == 10 {
                rewrite this.pos = this.pos + 1
                rewrite this.line = this.line + 1
                rewrite this.col = 1
            }
        }

        rewrite this.at_line_start = true
        this.enqueue(YAML_TOK_STRING, res, 0.0, false)
    }

    fun scan_plain_scalar() {
        set start: int64 = this.pos
        while this.pos < this.len {
            set b: uint8 = this.text[this.pos]
            if b == 10 || b == 13 || b == 35 { // newline or comment
                break
            }
            if b == 58 { // ':' check if key delimiter
                set next_b: uint8 = this.peek_char(1)
                if next_b == 32 || next_b == 9 || next_b == 10 || next_b == 13 || next_b == 0 || (this.in_flow > 0 && next_b == 44) {
                    break
                }
            }
            if this.in_flow > 0 && (b == 44 || b == 93 || b == 125) { // , ] }
                break
            }
            rewrite this.pos = this.pos + 1
            rewrite this.col = this.col + 1
        }

        set raw: string = slice(this.text, start, this.pos)
        set s: string = trim(raw)

        // Resolve scalar kind
        if s == "true" || s == "True" || s == "TRUE" || s == "yes" || s == "Yes" || s == "YES" || s == "on" || s == "On" || s == "ON" {
            this.enqueue(YAML_TOK_BOOLEAN, s, 1.0, true)
            return
        }
        if s == "false" || s == "False" || s == "FALSE" || s == "no" || s == "No" || s == "NO" || s == "off" || s == "Off" || s == "OFF" {
            this.enqueue(YAML_TOK_BOOLEAN, s, 0.0, false)
            return
        }
        if s == "null" || s == "Null" || s == "NULL" || s == "~" {
            this.enqueue(YAML_TOK_NULL, s, 0.0, false)
            return
        }
        if s == ".inf" || s == "+.inf" {
            this.enqueue(YAML_TOK_NUMBER, s, 1.0 / 0.0, false)
            return
        }
        if s == "-.inf" {
            this.enqueue(YAML_TOK_NUMBER, s, -1.0 / 0.0, false)
            return
        }
        if s == ".nan" {
            this.enqueue(YAML_TOK_NUMBER, s, 0.0 / 0.0, false)
            return
        }

        // Try number parsing
        set parsed_i: int64? = parse_int(s)
        if parsed_i != null {
            this.enqueue(YAML_TOK_NUMBER, s, cast(parsed_i ?? 0, "float64"), false)
            return
        }
        set parsed_f: float64? = parse_float(s)
        if parsed_f != null {
            this.enqueue(YAML_TOK_NUMBER, s, parsed_f ?? 0.0, false)
            return
        }

        this.enqueue(YAML_TOK_STRING, s, 0.0, false)
    }
}
