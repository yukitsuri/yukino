load ..fs.files: file_size, open_read, File
load .common: HashError, bytes_to_hex

fun k256(i: int64) -> uint32 {
    switch i {
        0 -> { return 0x428a2f98u32 }
        1 -> { return 0x71374491u32 }
        2 -> { return 0xb5c0fbcfu32 }
        3 -> { return 0xe9b5dba5u32 }
        4 -> { return 0x3956c25bu32 }
        5 -> { return 0x59f111f1u32 }
        6 -> { return 0x923f82a4u32 }
        7 -> { return 0xab1c5ed5u32 }
        8 -> { return 0xd807aa98u32 }
        9 -> { return 0x12835b01u32 }
        10 -> { return 0x243185beu32 }
        11 -> { return 0x550c7dc3u32 }
        12 -> { return 0x72be5d74u32 }
        13 -> { return 0x80deb1feu32 }
        14 -> { return 0x9bdc06a7u32 }
        15 -> { return 0xc19bf174u32 }
        16 -> { return 0xe49b69c1u32 }
        17 -> { return 0xefbe4786u32 }
        18 -> { return 0x0fc19dc6u32 }
        19 -> { return 0x240ca1ccu32 }
        20 -> { return 0x2de92c6fu32 }
        21 -> { return 0x4a7484aau32 }
        22 -> { return 0x5cb0a9dcu32 }
        23 -> { return 0x76f988dau32 }
        24 -> { return 0x983e5152u32 }
        25 -> { return 0xa831c66du32 }
        26 -> { return 0xb00327c8u32 }
        27 -> { return 0xbf597fc7u32 }
        28 -> { return 0xc6e00bf3u32 }
        29 -> { return 0xd5a79147u32 }
        30 -> { return 0x06ca6351u32 }
        31 -> { return 0x14292967u32 }
        32 -> { return 0x27b70a85u32 }
        33 -> { return 0x2e1b2138u32 }
        34 -> { return 0x4d2c6dfcu32 }
        35 -> { return 0x53380d13u32 }
        36 -> { return 0x650a7354u32 }
        37 -> { return 0x766a0abbu32 }
        38 -> { return 0x81c2c92eu32 }
        39 -> { return 0x92722c85u32 }
        40 -> { return 0xa2bfe8a1u32 }
        41 -> { return 0xa81a664bu32 }
        42 -> { return 0xc24b8b70u32 }
        43 -> { return 0xc76c51a3u32 }
        44 -> { return 0xd192e819u32 }
        45 -> { return 0xd6990624u32 }
        46 -> { return 0xf40e3585u32 }
        47 -> { return 0x106aa070u32 }
        48 -> { return 0x19a4c116u32 }
        49 -> { return 0x1e376c08u32 }
        50 -> { return 0x2748774cu32 }
        51 -> { return 0x34b0bcb5u32 }
        52 -> { return 0x391c0cb3u32 }
        53 -> { return 0x4ed8aa4au32 }
        54 -> { return 0x5b9cca4fu32 }
        55 -> { return 0x682e6ff3u32 }
        56 -> { return 0x748f82eeu32 }
        57 -> { return 0x78a5636fu32 }
        58 -> { return 0x84c87814u32 }
        59 -> { return 0x8cc70208u32 }
        60 -> { return 0x90befffau32 }
        61 -> { return 0xa4506cebu32 }
        62 -> { return 0xbef9a3f7u32 }
        63 -> { return 0xc67178f2u32 }
        else -> { return 0u32 }
    }
    return 0u32
}

fun rotr32(x: uint32, n: int64) -> uint32 {
    set nu: uint32 = cast(n, "uint32")
    set diff: uint32 = cast(32 - n, "uint32")
    return (x >> nu) | (x << diff)
}

fun ch32(x: uint32, y: uint32, z: uint32) -> uint32 {
    return (x & y) ^ ((~x) & z)
}

fun maj32(x: uint32, y: uint32, z: uint32) -> uint32 {
    return (x & y) ^ (x & z) ^ (y & z)
}

fun sigma0_256(x: uint32) -> uint32 {
    return rotr32(x, 2) ^ rotr32(x, 13) ^ rotr32(x, 22)
}

fun sigma1_256(x: uint32) -> uint32 {
    return rotr32(x, 6) ^ rotr32(x, 11) ^ rotr32(x, 25)
}

fun gamma0_256(x: uint32) -> uint32 {
    return rotr32(x, 7) ^ rotr32(x, 18) ^ (x >> 3u32)
}

fun gamma1_256(x: uint32) -> uint32 {
    return rotr32(x, 17) ^ rotr32(x, 19) ^ (x >> 10u32)
}

fun load32_be(ref data: bytes, offset: int64) -> uint32 {
    return (cast(data[offset], "uint32") << 24u32) |
           (cast(data[offset + 1], "uint32") << 16u32) |
           (cast(data[offset + 2], "uint32") << 8u32) |
           cast(data[offset + 3], "uint32")
}

public class Sha256 {
    h0: uint32
    h1: uint32
    h2: uint32
    h3: uint32
    h4: uint32
    h5: uint32
    h6: uint32
    h7: uint32
    total_len: int64
    b0: uint32
    b1: uint32
    b2: uint32
    b3: uint32
    b4: uint32
    b5: uint32
    b6: uint32
    b7: uint32
    b8: uint32
    b9: uint32
    b10: uint32
    b11: uint32
    b12: uint32
    b13: uint32
    b14: uint32
    b15: uint32
    buf_len: int32

    public fun init() {
        rewrite this.h0 = 0x6a09e667u32
        rewrite this.h1 = 0xbb67ae85u32
        rewrite this.h2 = 0x3c6ef372u32
        rewrite this.h3 = 0xa54ff53au32
        rewrite this.h4 = 0x510e527fu32
        rewrite this.h5 = 0x9b05688cu32
        rewrite this.h6 = 0x1f83d9abu32
        rewrite this.h7 = 0x5be0cd19u32
        rewrite this.total_len = 0
        rewrite this.b0 = 0u32; rewrite this.b1 = 0u32; rewrite this.b2 = 0u32; rewrite this.b3 = 0u32
        rewrite this.b4 = 0u32; rewrite this.b5 = 0u32; rewrite this.b6 = 0u32; rewrite this.b7 = 0u32
        rewrite this.b8 = 0u32; rewrite this.b9 = 0u32; rewrite this.b10 = 0u32; rewrite this.b11 = 0u32
        rewrite this.b12 = 0u32; rewrite this.b13 = 0u32; rewrite this.b14 = 0u32; rewrite this.b15 = 0u32
        rewrite this.buf_len = 0
    }

    public fun reset() {
        rewrite this.h0 = 0x6a09e667u32
        rewrite this.h1 = 0xbb67ae85u32
        rewrite this.h2 = 0x3c6ef372u32
        rewrite this.h3 = 0xa54ff53au32
        rewrite this.h4 = 0x510e527fu32
        rewrite this.h5 = 0x9b05688cu32
        rewrite this.h6 = 0x1f83d9abu32
        rewrite this.h7 = 0x5be0cd19u32
        rewrite this.total_len = 0
        rewrite this.b0 = 0u32; rewrite this.b1 = 0u32; rewrite this.b2 = 0u32; rewrite this.b3 = 0u32
        rewrite this.b4 = 0u32; rewrite this.b5 = 0u32; rewrite this.b6 = 0u32; rewrite this.b7 = 0u32
        rewrite this.b8 = 0u32; rewrite this.b9 = 0u32; rewrite this.b10 = 0u32; rewrite this.b11 = 0u32
        rewrite this.b12 = 0u32; rewrite this.b13 = 0u32; rewrite this.b14 = 0u32; rewrite this.b15 = 0u32
        rewrite this.buf_len = 0
    }

    // write one byte at offset off (0..63) via masks and shifts
    public fun set_buf_byte(off: int64, val: uint8) {
        set v: uint32 = cast(val, "uint32")
        if off == 0 {
            rewrite this.b0 = (this.b0 & 0x00ffffffu32) | (v << 24u32)
        } elif off == 1 {
            rewrite this.b0 = (this.b0 & 0xff00ffffu32) | (v << 16u32)
        } elif off == 2 {
            rewrite this.b0 = (this.b0 & 0xffff00ffu32) | (v << 8u32)
        } elif off == 3 {
            rewrite this.b0 = (this.b0 & 0xffffff00u32) | v
        } elif off == 4 {
            rewrite this.b1 = (this.b1 & 0x00ffffffu32) | (v << 24u32)
        } elif off == 5 {
            rewrite this.b1 = (this.b1 & 0xff00ffffu32) | (v << 16u32)
        } elif off == 6 {
            rewrite this.b1 = (this.b1 & 0xffff00ffu32) | (v << 8u32)
        } elif off == 7 {
            rewrite this.b1 = (this.b1 & 0xffffff00u32) | v
        } elif off == 8 {
            rewrite this.b2 = (this.b2 & 0x00ffffffu32) | (v << 24u32)
        } elif off == 9 {
            rewrite this.b2 = (this.b2 & 0xff00ffffu32) | (v << 16u32)
        } elif off == 10 {
            rewrite this.b2 = (this.b2 & 0xffff00ffu32) | (v << 8u32)
        } elif off == 11 {
            rewrite this.b2 = (this.b2 & 0xffffff00u32) | v
        } elif off == 12 {
            rewrite this.b3 = (this.b3 & 0x00ffffffu32) | (v << 24u32)
        } elif off == 13 {
            rewrite this.b3 = (this.b3 & 0xff00ffffu32) | (v << 16u32)
        } elif off == 14 {
            rewrite this.b3 = (this.b3 & 0xffff00ffu32) | (v << 8u32)
        } elif off == 15 {
            rewrite this.b3 = (this.b3 & 0xffffff00u32) | v
        } elif off == 16 {
            rewrite this.b4 = (this.b4 & 0x00ffffffu32) | (v << 24u32)
        } elif off == 17 {
            rewrite this.b4 = (this.b4 & 0xff00ffffu32) | (v << 16u32)
        } elif off == 18 {
            rewrite this.b4 = (this.b4 & 0xffff00ffu32) | (v << 8u32)
        } elif off == 19 {
            rewrite this.b4 = (this.b4 & 0xffffff00u32) | v
        } elif off == 20 {
            rewrite this.b5 = (this.b5 & 0x00ffffffu32) | (v << 24u32)
        } elif off == 21 {
            rewrite this.b5 = (this.b5 & 0xff00ffffu32) | (v << 16u32)
        } elif off == 22 {
            rewrite this.b5 = (this.b5 & 0xffff00ffu32) | (v << 8u32)
        } elif off == 23 {
            rewrite this.b5 = (this.b5 & 0xffffff00u32) | v
        } elif off == 24 {
            rewrite this.b6 = (this.b6 & 0x00ffffffu32) | (v << 24u32)
        } elif off == 25 {
            rewrite this.b6 = (this.b6 & 0xff00ffffu32) | (v << 16u32)
        } elif off == 26 {
            rewrite this.b6 = (this.b6 & 0xffff00ffu32) | (v << 8u32)
        } elif off == 27 {
            rewrite this.b6 = (this.b6 & 0xffffff00u32) | v
        } elif off == 28 {
            rewrite this.b7 = (this.b7 & 0x00ffffffu32) | (v << 24u32)
        } elif off == 29 {
            rewrite this.b7 = (this.b7 & 0xff00ffffu32) | (v << 16u32)
        } elif off == 30 {
            rewrite this.b7 = (this.b7 & 0xffff00ffu32) | (v << 8u32)
        } elif off == 31 {
            rewrite this.b7 = (this.b7 & 0xffffff00u32) | v
        } elif off == 32 {
            rewrite this.b8 = (this.b8 & 0x00ffffffu32) | (v << 24u32)
        } elif off == 33 {
            rewrite this.b8 = (this.b8 & 0xff00ffffu32) | (v << 16u32)
        } elif off == 34 {
            rewrite this.b8 = (this.b8 & 0xffff00ffu32) | (v << 8u32)
        } elif off == 35 {
            rewrite this.b8 = (this.b8 & 0xffffff00u32) | v
        } elif off == 36 {
            rewrite this.b9 = (this.b9 & 0x00ffffffu32) | (v << 24u32)
        } elif off == 37 {
            rewrite this.b9 = (this.b9 & 0xff00ffffu32) | (v << 16u32)
        } elif off == 38 {
            rewrite this.b9 = (this.b9 & 0xffff00ffu32) | (v << 8u32)
        } elif off == 39 {
            rewrite this.b9 = (this.b9 & 0xffffff00u32) | v
        } elif off == 40 {
            rewrite this.b10 = (this.b10 & 0x00ffffffu32) | (v << 24u32)
        } elif off == 41 {
            rewrite this.b10 = (this.b10 & 0xff00ffffu32) | (v << 16u32)
        } elif off == 42 {
            rewrite this.b10 = (this.b10 & 0xffff00ffu32) | (v << 8u32)
        } elif off == 43 {
            rewrite this.b10 = (this.b10 & 0xffffff00u32) | v
        } elif off == 44 {
            rewrite this.b11 = (this.b11 & 0x00ffffffu32) | (v << 24u32)
        } elif off == 45 {
            rewrite this.b11 = (this.b11 & 0xff00ffffu32) | (v << 16u32)
        } elif off == 46 {
            rewrite this.b11 = (this.b11 & 0xffff00ffu32) | (v << 8u32)
        } elif off == 47 {
            rewrite this.b11 = (this.b11 & 0xffffff00u32) | v
        } elif off == 48 {
            rewrite this.b12 = (this.b12 & 0x00ffffffu32) | (v << 24u32)
        } elif off == 49 {
            rewrite this.b12 = (this.b12 & 0xff00ffffu32) | (v << 16u32)
        } elif off == 50 {
            rewrite this.b12 = (this.b12 & 0xffff00ffu32) | (v << 8u32)
        } elif off == 51 {
            rewrite this.b12 = (this.b12 & 0xffffff00u32) | v
        } elif off == 52 {
            rewrite this.b13 = (this.b13 & 0x00ffffffu32) | (v << 24u32)
        } elif off == 53 {
            rewrite this.b13 = (this.b13 & 0xff00ffffu32) | (v << 16u32)
        } elif off == 54 {
            rewrite this.b13 = (this.b13 & 0xffff00ffu32) | (v << 8u32)
        } elif off == 55 {
            rewrite this.b13 = (this.b13 & 0xffffff00u32) | v
        } elif off == 56 {
            rewrite this.b14 = (this.b14 & 0x00ffffffu32) | (v << 24u32)
        } elif off == 57 {
            rewrite this.b14 = (this.b14 & 0xff00ffffu32) | (v << 16u32)
        } elif off == 58 {
            rewrite this.b14 = (this.b14 & 0xffff00ffu32) | (v << 8u32)
        } elif off == 59 {
            rewrite this.b14 = (this.b14 & 0xffffff00u32) | v
        } elif off == 60 {
            rewrite this.b15 = (this.b15 & 0x00ffffffu32) | (v << 24u32)
        } elif off == 61 {
            rewrite this.b15 = (this.b15 & 0xff00ffffu32) | (v << 16u32)
        } elif off == 62 {
            rewrite this.b15 = (this.b15 & 0xffff00ffu32) | (v << 8u32)
        } else {
            rewrite this.b15 = (this.b15 & 0xffffff00u32) | v
        }
    }

    public fun update(data: bytes) {
        sha256_update(ref ~this, ref data)
    }

    public fun update_str(s: string) {
        set d: bytes = cast(s, "bytes")
        sha256_update(ref ~this, ref d)
    }

    public fun finish() -> bytes {
        return sha256_finish(ref ~this)
    }

    public fun finish_hex() -> string {
        set b: bytes = sha256_finish(ref ~this)
        return bytes_to_hex(ref b)
    }
}

fun sha256_load_block(ref ~st: Sha256, ref data: bytes, offset: int64) {
    rewrite st.b0 = load32_be(ref data, offset)
    rewrite st.b1 = load32_be(ref data, offset + 4)
    rewrite st.b2 = load32_be(ref data, offset + 8)
    rewrite st.b3 = load32_be(ref data, offset + 12)
    rewrite st.b4 = load32_be(ref data, offset + 16)
    rewrite st.b5 = load32_be(ref data, offset + 20)
    rewrite st.b6 = load32_be(ref data, offset + 24)
    rewrite st.b7 = load32_be(ref data, offset + 28)
    rewrite st.b8 = load32_be(ref data, offset + 32)
    rewrite st.b9 = load32_be(ref data, offset + 36)
    rewrite st.b10 = load32_be(ref data, offset + 40)
    rewrite st.b11 = load32_be(ref data, offset + 44)
    rewrite st.b12 = load32_be(ref data, offset + 48)
    rewrite st.b13 = load32_be(ref data, offset + 52)
    rewrite st.b14 = load32_be(ref data, offset + 56)
    rewrite st.b15 = load32_be(ref data, offset + 60)
}

fun sha256_process_block(ref ~st: Sha256) {
    set w: uint32[64]
    rewrite w[0] = st.b0
    rewrite w[1] = st.b1
    rewrite w[2] = st.b2
    rewrite w[3] = st.b3
    rewrite w[4] = st.b4
    rewrite w[5] = st.b5
    rewrite w[6] = st.b6
    rewrite w[7] = st.b7
    rewrite w[8] = st.b8
    rewrite w[9] = st.b9
    rewrite w[10] = st.b10
    rewrite w[11] = st.b11
    rewrite w[12] = st.b12
    rewrite w[13] = st.b13
    rewrite w[14] = st.b14
    rewrite w[15] = st.b15
    for i in 16..64 {
        set s0: uint32 = gamma0_256(w[i - 15])
        set s1: uint32 = gamma1_256(w[i - 2])
        rewrite w[i] = w[i - 16] + s0 + w[i - 7] + s1
    }

    set a: uint32 = st.h0
    set b: uint32 = st.h1
    set c: uint32 = st.h2
    set d: uint32 = st.h3
    set e: uint32 = st.h4
    set f: uint32 = st.h5
    set g: uint32 = st.h6
    set h: uint32 = st.h7

    for i in 0..64 {
        set t1: uint32 = h + sigma1_256(e) + ch32(e, f, g) + k256(i) + w[i]
        set t2: uint32 = sigma0_256(a) + maj32(a, b, c)
        rewrite h = g
        rewrite g = f
        rewrite f = e
        rewrite e = d + t1
        rewrite d = c
        rewrite c = b
        rewrite b = a
        rewrite a = t1 + t2
    }

    rewrite st.h0 = st.h0 + a
    rewrite st.h1 = st.h1 + b
    rewrite st.h2 = st.h2 + c
    rewrite st.h3 = st.h3 + d
    rewrite st.h4 = st.h4 + e
    rewrite st.h5 = st.h5 + f
    rewrite st.h6 = st.h6 + g
    rewrite st.h7 = st.h7 + h
}

public fun sha256_init() -> Sha256 {
    return init Sha256()
}

public fun sha256_update(ref ~st: Sha256, ref data: bytes) {
    set len: int64 = data.len()
    rewrite st.total_len = st.total_len + len
    set p: int64 = 0
    set rem: int64 = len

    if st.buf_len > 0 {
        set need: int32 = 64 - st.buf_len
        if cast(rem, "int32") < need {
            for i in 0..rem {
                st.set_buf_byte(cast(st.buf_len, "int64") + i, data[p + i])
            }
            rewrite st.buf_len = st.buf_len + cast(rem, "int32")
            return
        }
        set need_64: int64 = cast(need, "int64")
        for i in 0..need_64 {
            st.set_buf_byte(cast(st.buf_len, "int64") + i, data[p + i])
        }
        sha256_process_block(ref ~st)
        rewrite p = p + need_64
        rewrite rem = rem - need_64
        rewrite st.buf_len = 0
    }

    set blocks: int64 = rem / 64
    for i in 0..blocks {
        sha256_load_block(ref ~st, ref data, p)
        sha256_process_block(ref ~st)
        rewrite p = p + 64
        rewrite rem = rem - 64
    }

    if rem > 0 {
        for i in 0..rem {
            st.set_buf_byte(i, data[p + i])
        }
        rewrite st.buf_len = cast(rem, "int32")
    }
}

public fun sha256_finish(ref ~st: Sha256) -> bytes {
    set bit_len: uint64 = cast(st.total_len, "uint64") * 8u64
    st.set_buf_byte(cast(st.buf_len, "int64"), 0x80u8)
    rewrite st.buf_len = st.buf_len + 1

    if st.buf_len > 56 {
        while st.buf_len < 64 {
            st.set_buf_byte(cast(st.buf_len, "int64"), 0u8)
            rewrite st.buf_len = st.buf_len + 1
        }
        sha256_process_block(ref ~st)
        rewrite st.buf_len = 0
    }

    while st.buf_len < 56 {
        st.set_buf_byte(cast(st.buf_len, "int64"), 0u8)
        rewrite st.buf_len = st.buf_len + 1
    }

    for i in 0..8 {
        set shift: uint64 = cast((7 - i) * 8, "uint64")
        st.set_buf_byte(56 + i, cast((bit_len >> shift) & 255u64, "uint8"))
    }

    sha256_process_block(ref ~st)

    set out: uint8[32]
    set hs: uint32[8]
    rewrite hs[0] = st.h0
    rewrite hs[1] = st.h1
    rewrite hs[2] = st.h2
    rewrite hs[3] = st.h3
    rewrite hs[4] = st.h4
    rewrite hs[5] = st.h5
    rewrite hs[6] = st.h6
    rewrite hs[7] = st.h7

    for i in 0..8 {
        set val: uint32 = hs[i]
        rewrite out[i * 4] = cast((val >> 24u32) & 255u32, "uint8")
        rewrite out[i * 4 + 1] = cast((val >> 16u32) & 255u32, "uint8")
        rewrite out[i * 4 + 2] = cast((val >> 8u32) & 255u32, "uint8")
        rewrite out[i * 4 + 3] = cast(val & 255u32, "uint8")
    }
    return cast(from_raw_parts(out.as_ptr(), 32), "bytes")
}

public fun sha256(ref data: bytes) -> bytes {
    set st: Sha256 = init Sha256()
    set d: bytes = cast(from_raw_parts(data.as_ptr(), data.len()), "bytes")
    st.update(d)
    return st.finish()
}

public fun sha256_str(s: string) -> string {
    set st: Sha256 = init Sha256()
    st.update_str(s)
    return st.finish_hex()
}

public fun sha256_file(path: string) -> string {
    set sz: int64 = file_size(path.cp())
    if sz < 0 {
        panic(HashError {
            message: "file not found or cannot get size",
            code: 103,
        })
    }
    set f: File = open_read(path)
    set st: Sha256 = init Sha256()
    if sz == 0 {
        f.close()
        return st.finish_hex()
    }
    set buf: uint8[65536]
    set rem: int64 = sz
    while rem > 0 {
        set to_read: int64 = if rem > 65536 { 65536 } else { rem }
        set n: int64 = f.read(buf.as_ptr(), to_read)
        if n <= 0 {
            f.close()
            panic(HashError {
                message: "error reading file",
                code: 104,
            })
        }
        set chunk: bytes = cast(from_raw_parts(buf.as_ptr(), n), "bytes")
        st.update(chunk)
        rewrite rem = rem - n
    }
    f.close()
    return st.finish_hex()
}

fun k512(i: int64) -> uint64 {
    switch i {
        0 -> { return 0x428a2f98d728ae22u64 }
        1 -> { return 0x7137449123ef65cdu64 }
        2 -> { return 0xb5c0fbcfec4d3b2fu64 }
        3 -> { return 0xe9b5dba58189dbbcu64 }
        4 -> { return 0x3956c25bf348b538u64 }
        5 -> { return 0x59f111f1b605d019u64 }
        6 -> { return 0x923f82a4af194f9bu64 }
        7 -> { return 0xab1c5ed5da6d8118u64 }
        8 -> { return 0xd807aa98a3030242u64 }
        9 -> { return 0x12835b0145706fbeu64 }
