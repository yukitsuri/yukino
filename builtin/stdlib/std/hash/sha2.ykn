fun rotr64(x: uint64, n: int64) -> uint64 {
    set nu: uint64 = cast(n, "uint64")
    set diff: uint64 = cast(64 - n, "uint64")
    return (x >> nu) | (x << diff)
}

fun ch64(x: uint64, y: uint64, z: uint64) -> uint64 {
    return (x & y) ^ ((~x) & z)
}

fun maj64(x: uint64, y: uint64, z: uint64) -> uint64 {
    return (x & y) ^ (x & z) ^ (y & z)
}

fun sigma0_512(x: uint64) -> uint64 {
    return rotr64(x, 28) ^ rotr64(x, 34) ^ rotr64(x, 39)
}

fun sigma1_512(x: uint64) -> uint64 {
    return rotr64(x, 14) ^ rotr64(x, 18) ^ rotr64(x, 41)
}

fun gamma0_512(x: uint64) -> uint64 {
    return rotr64(x, 1) ^ rotr64(x, 8) ^ (x >> 7u64)
}

fun gamma1_512(x: uint64) -> uint64 {
    return rotr64(x, 19) ^ rotr64(x, 61) ^ (x >> 6u64)
}

fun load64_be(ref data: bytes, offset: int64) -> uint64 {
    return (cast(data[offset], "uint64") << 56u64) |
           (cast(data[offset + 1], "uint64") << 48u64) |
           (cast(data[offset + 2], "uint64") << 40u64) |
           (cast(data[offset + 3], "uint64") << 32u64) |
           (cast(data[offset + 4], "uint64") << 24u64) |
           (cast(data[offset + 5], "uint64") << 16u64) |
           (cast(data[offset + 6], "uint64") << 8u64) |
           cast(data[offset + 7], "uint64")
}

