            rewrite this.b15 = (this.b15 & 0xffffffff00ffffffu64) | (v << 24u64)
        } elif off == 125 {
            rewrite this.b15 = (this.b15 & 0xffffffffff00ffffu64) | (v << 16u64)
        } elif off == 126 {
            rewrite this.b15 = (this.b15 & 0xffffffffffff00ffu64) | (v << 8u64)
        } else {
            rewrite this.b15 = (this.b15 & 0xffffffffffffff00u64) | v
        }
    }

    public fun update(data: bytes) {
        sha512_update(ref ~this, ref data)
    }

    public fun update_str(s: string) {
        set d: bytes = cast(s, "bytes")
        sha512_update(ref ~this, ref d)
    }

    public fun finish() -> bytes {
        return sha512_finish(ref ~this)
    }

    public fun finish_hex() -> string {
        set b: bytes = sha512_finish(ref ~this)
        return bytes_to_hex(ref b)
    }
}

fun sha512_load_block(ref ~st: Sha512, ref data: bytes, offset: int64) {
    rewrite st.b0 = load64_be(ref data, offset)
    rewrite st.b1 = load64_be(ref data, offset + 8)
    rewrite st.b2 = load64_be(ref data, offset + 16)
    rewrite st.b3 = load64_be(ref data, offset + 24)
    rewrite st.b4 = load64_be(ref data, offset + 32)
    rewrite st.b5 = load64_be(ref data, offset + 40)
    rewrite st.b6 = load64_be(ref data, offset + 48)
    rewrite st.b7 = load64_be(ref data, offset + 56)
    rewrite st.b8 = load64_be(ref data, offset + 64)
    rewrite st.b9 = load64_be(ref data, offset + 72)
    rewrite st.b10 = load64_be(ref data, offset + 80)
    rewrite st.b11 = load64_be(ref data, offset + 88)
    rewrite st.b12 = load64_be(ref data, offset + 96)
    rewrite st.b13 = load64_be(ref data, offset + 104)
    rewrite st.b14 = load64_be(ref data, offset + 112)
    rewrite st.b15 = load64_be(ref data, offset + 120)
}

fun sha512_process_block(ref ~st: Sha512) {
    set w: uint64[80]
    rewrite w[0] = st.b0
    rewrite w[1] = st.b1
    rewrite w[2] = st.b2
    rewrite w[3] = st.b3
    rewrite w[4] = st.b4
    rewrite w[5] = st.b5
    rewrite w[6] = st.b6
    rewrite w[7] = st.b7
    rewrite w[8] = st.b8
    rewrite w[9] = st.b9
    rewrite w[10] = st.b10
    rewrite w[11] = st.b11
    rewrite w[12] = st.b12
    rewrite w[13] = st.b13
    rewrite w[14] = st.b14
    rewrite w[15] = st.b15
    for i in 16..80 {
        set s0: uint64 = gamma0_512(w[i - 15])
        set s1: uint64 = gamma1_512(w[i - 2])
        rewrite w[i] = w[i - 16] + s0 + w[i - 7] + s1
    }

    set a: uint64 = st.h0
    set b: uint64 = st.h1
    set c: uint64 = st.h2
    set d: uint64 = st.h3
    set e: uint64 = st.h4
    set f: uint64 = st.h5
    set g: uint64 = st.h6
    set h: uint64 = st.h7

    for i in 0..80 {
        set t1: uint64 = h + sigma1_512(e) + ch64(e, f, g) + k512(i) + w[i]
        set t2: uint64 = sigma0_512(a) + maj64(a, b, c)
        rewrite h = g
        rewrite g = f
        rewrite f = e
        rewrite e = d + t1
        rewrite d = c
        rewrite c = b
        rewrite b = a
        rewrite a = t1 + t2
    }

    rewrite st.h0 = st.h0 + a
    rewrite st.h1 = st.h1 + b
    rewrite st.h2 = st.h2 + c
    rewrite st.h3 = st.h3 + d
    rewrite st.h4 = st.h4 + e
    rewrite st.h5 = st.h5 + f
    rewrite st.h6 = st.h6 + g
    rewrite st.h7 = st.h7 + h
}

public fun sha512_init() -> Sha512 {
    return init Sha512()
}

public fun sha512_update(ref ~st: Sha512, ref data: bytes) {
    set len: int64 = data.len()
    rewrite st.total_len = st.total_len + len
    set p: int64 = 0
    set rem: int64 = len

    if st.buf_len > 0 {
        set need: int32 = 128 - st.buf_len
        if cast(rem, "int32") < need {
            for i in 0..rem {
                st.set_buf_byte(cast(st.buf_len, "int64") + i, data[p + i])
            }
            rewrite st.buf_len = st.buf_len + cast(rem, "int32")
            return
        }
        set need_64: int64 = cast(need, "int64")
        for i in 0..need_64 {
            st.set_buf_byte(cast(st.buf_len, "int64") + i, data[p + i])
        }
        sha512_process_block(ref ~st)
        rewrite p = p + need_64
        rewrite rem = rem - need_64
        rewrite st.buf_len = 0
    }

    set blocks: int64 = rem / 128
    for i in 0..blocks {
        sha512_load_block(ref ~st, ref data, p)
        sha512_process_block(ref ~st)
        rewrite p = p + 128
        rewrite rem = rem - 128
    }

    if rem > 0 {
        for i in 0..rem {
            st.set_buf_byte(i, data[p + i])
        }
        rewrite st.buf_len = cast(rem, "int32")
    }
}

public fun sha512_finish(ref ~st: Sha512) -> bytes {
    set bit_len: uint64 = cast(st.total_len, "uint64") * 8u64
    st.set_buf_byte(cast(st.buf_len, "int64"), 0x80u8)
    rewrite st.buf_len = st.buf_len + 1

    if st.buf_len > 112 {
        while st.buf_len < 128 {
            st.set_buf_byte(cast(st.buf_len, "int64"), 0u8)
            rewrite st.buf_len = st.buf_len + 1
        }
        sha512_process_block(ref ~st)
        rewrite st.buf_len = 0
    }

    while st.buf_len < 112 {
        st.set_buf_byte(cast(st.buf_len, "int64"), 0u8)
        rewrite st.buf_len = st.buf_len + 1
    }

    for i in 0..8 {
        st.set_buf_byte(112 + i, 0u8)
    }
    for i in 0..8 {
        set shift: uint64 = cast((7 - i) * 8, "uint64")
        st.set_buf_byte(120 + i, cast((bit_len >> shift) & 255u64, "uint8"))
    }

    sha512_process_block(ref ~st)

    set out: uint8[64]
    set hs: uint64[8]
    rewrite hs[0] = st.h0
    rewrite hs[1] = st.h1
    rewrite hs[2] = st.h2
    rewrite hs[3] = st.h3
    rewrite hs[4] = st.h4
    rewrite hs[5] = st.h5
    rewrite hs[6] = st.h6
    rewrite hs[7] = st.h7

    for i in 0..8 {
        set val: uint64 = hs[i]
        for j in 0..8 {
            set shift: uint64 = cast((7 - j) * 8, "uint64")
            rewrite out[i * 8 + j] = cast((val >> shift) & 255u64, "uint8")
        }
    }
    return cast(from_raw_parts(out.as_ptr(), 64), "bytes")
}

public fun sha512(ref data: bytes) -> bytes {
    set st: Sha512 = init Sha512()
    set d: bytes = cast(from_raw_parts(data.as_ptr(), data.len()), "bytes")
    st.update(d)
    return st.finish()
}

public fun sha512_str(s: string) -> string {
    set st: Sha512 = init Sha512()
    st.update_str(s)
    return st.finish_hex()
}

public fun sha512_file(path: string) -> string {
    set sz: int64 = file_size(path.cp())
    if sz < 0 {
        panic(HashError {
            message: "file not found or cannot get size",
            code: 103,
        })
    }
    set f: File = open_read(path)
    set st: Sha512 = init Sha512()
    if sz == 0 {
        f.close()
        return st.finish_hex()
    }
    set buf: uint8[65536]
    set rem: int64 = sz
    while rem > 0 {
        set to_read: int64 = if rem > 65536 { 65536 } else { rem }
        set n: int64 = f.read(buf.as_ptr(), to_read)
        if n <= 0 {
            f.close()
            panic(HashError {
                message: "error reading file",
                code: 104,
            })
        }
        set chunk: bytes = cast(from_raw_parts(buf.as_ptr(), n), "bytes")
        st.update(chunk)
        rewrite rem = rem - n
    }
    f.close()
    return st.finish_hex()
}
