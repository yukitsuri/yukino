load .strings: trim, trim_start, to_lowercase, lines, slice, index_of, starts_with
load .fs.files: file_read_text, file_exists
load .collections.hashmap: HashMap

// decl core/strings.rs start
cfun yukistd_str_parse_i64(p: ptr<uint8>, len: int64, out_val: ptr<int64>) -> bool
cfun yukistd_str_parse_f64(p: ptr<uint8>, len: int64, out_val: ptr<float64>) -> bool

// decl core/process.rs start
cfun yukistd_process_get_env(name_p: ptr<uint8>, name_len: int64, out_len: ptr<int64>) -> ptr<uint8>
cfun yukistd_process_set_env(name_p: ptr<uint8>, name_len: int64, val_p: ptr<uint8>, val_len: int64) -> bool
cfun yukistd_process_remove_env(name_p: ptr<uint8>, name_len: int64) -> bool
cfun yukistd_process_all_envs(out_count: ptr<int64>) -> ptr<string>
// decl end

public struct EnvEntry {
    key: string
    value: string
}

public struct EnvError {
    message: string
    key: string
}

public fun get_env(key: string) -> string? {
    set out_len: int64 = 0
    set p = yukistd_process_get_env(key.as_ptr(), key.len(), ptr_of(out_len))
    if out_len < 0 || p == null { return null }
    if out_len == 0 { return "" }
    return from_raw_parts(p, out_len)
}

public fun env(key: string) -> string? { return get_env(key) }

public fun get_or(key: string, default_val: string) -> string {
    set v = get_env(key)
    return v ?? default_val
}

public fun get_int(key: string, default_val: int64 = 0) -> int64 {
    set v = get_env(key)
    if v == null { return default_val }
    set s = v ?? ""
    set trimmed = trim(s)
    if trimmed.len() == 0 { return default_val }
    set parsed: int64 = 0
    if yukistd_str_parse_i64(trimmed.as_ptr(), trimmed.len(), ptr_of(parsed)) { return parsed }
    return default_val
}

public fun get_bool(key: string, default_val: bool = false) -> bool {
    set v = get_env(key)
    if v == null { return default_val }
    set s = v ?? ""
    set t = trim(s)
    set lower = to_lowercase(t)
    if lower == "true" || lower == "1" || lower == "yes" || lower == "on" { return true }
    if lower == "false" || lower == "0" || lower == "no" || lower == "off" { return false }
    return default_val
}

public fun get_float(key: string, default_val: float64 = 0.0) -> float64 {
    set v = get_env(key)
    if v == null { return default_val }
    set s = v ?? ""
    set trimmed = trim(s)
    if trimmed.len() == 0 { return default_val }
    set parsed: float64 = 0.0
    if yukistd_str_parse_f64(trimmed.as_ptr(), trimmed.len(), ptr_of(parsed)) {
        return parsed
    }
    return default_val
}

public fun require(key: string) -> string {
    set v = get_env(key)
    if v == null {
        panic(EnvError {
            message: "required environment variable '" + key + "' is not set",
            key: key,
        })
    }
    return v ?? ""
}

public fun require_env(key: string) -> string {
    return require(key)
}

public fun set_env(key: string, val: string) -> bool {
    return yukistd_process_set_env(key.as_ptr(), key.len(), val.as_ptr(), val.len())
}

public fun remove_env(key: string) -> bool {
    return yukistd_process_remove_env(key.as_ptr(), key.len())
}

public fun remove(key: string) -> bool { return remove_env(key) }
public fun has_env(key: string) -> bool { return get_env(key) != null }
public fun has(key: string) -> bool { return has_env(key) }

public fun all_entries() -> EnvEntry[] {
    set out_count: int64 = 0
    set p = yukistd_process_all_envs(ptr_of(out_count))
    set res: EnvEntry[] = []
    if out_count <= 0 || p == null {
        return res
    }
    set arr: string[] = from_raw_parts(p, out_count, out_count)
    for i in 0..out_count {
        set item = arr[i]
        set eq_pos = index_of(item, "=")
        if eq_pos >= 0 {
            set item_len = item.len()
            set k = slice(item, 0, eq_pos)
            set v = slice(item, eq_pos + 1, item_len)
            res.push(EnvEntry { key: k, value: v })
        }
    }
    return res
}

public fun all() -> HashMap<string, string> {
    set map = init HashMap<string, string>()
    set entries = all_entries()
    for i in 0..entries.len() {
        map.set(entries[i].key.cp(), entries[i].value.cp())
    }
    return map
}

public fun all_envs() -> HashMap<string, string> { return all() }

fun find_in_entries(ref entries: EnvEntry[], key: string) -> string? {
    for i in 0..entries.len() {
        if entries[i].key == key {
            return entries[i].value.cp()
        }
    }
    return null
}

fun interpolate_vars(raw: string, ref current_entries: EnvEntry[]) -> string {
    set res = ""
    set i: int64 = 0
    set n = raw.len()

    while i < n {
        if i + 1 < n && raw[i] == 36 && raw[i + 1] == 123 { // "${"
            set close_idx = -1
            set j = i + 2
            while j < n {
                if raw[j] == 125 { // "}"
                    rewrite close_idx = j
                    break
                }
                rewrite j = j + 1
            }

            if close_idx >= 0 {
                set expr = slice(raw, i + 2, close_idx)
                set var_name = expr.cp()
                set fallback: string? = null
                set colon_dash = index_of(expr, ":-")
                if colon_dash >= 0 {
                    rewrite var_name = slice(expr, 0, colon_dash)
                    set expr_len = expr.len()
                    rewrite fallback = slice(expr, colon_dash + 2, expr_len)
                }

                set val = find_in_entries(ref current_entries, var_name.cp())
                if val == null {
                    rewrite val = get_env(var_name)
                }

                if val != null {
                    set s = val ?? ""
                    if s.len() > 0 {
                        rewrite res = res + s
                    } elif fallback != null {
                        rewrite res = res + (fallback ?? "")
                    }
                } elif fallback != null {
                    rewrite res = res + (fallback ?? "")
                }

                rewrite i = close_idx + 1
                continue
            }
        }

        rewrite res = res + slice(raw, i, i + 1)
        rewrite i = i + 1
    }

    return res
}

fun unescape_double_quoted(raw: string) -> string {
    set res = ""
    set i: int64 = 0
    set n = raw.len()

    while i < n {
        if raw[i] == 92 && i + 1 < n { // "\"
            set next_char = raw[i + 1]
            if next_char == 110 { // "\n"
                rewrite res = res + "\n"
                rewrite i = i + 2
                continue
            }
            if next_char == 114 { // "\r"
                rewrite res = res + "\r"
                rewrite i = i + 2
                continue
            }
            if next_char == 116 { // "\t"
                rewrite res = res + "\t"
                rewrite i = i + 2
                continue
            }
            if next_char == 92 { // "\\"
                rewrite res = res + "\\"
                rewrite i = i + 2
                continue
            }
            if next_char == 34 { // "\""
                rewrite res = res + "\""
                rewrite i = i + 2
                continue
            }
            if next_char == 36 { // "\$"
                rewrite res = res + "$"
                rewrite i = i + 2
                continue
            }
        }

        rewrite res = res + slice(raw, i, i + 1)
        rewrite i = i + 1
    }

    return res
}

public fun parse_dotenv(content: string) -> EnvEntry[] {
    set res: EnvEntry[] = []
    set raw_lines = lines(content)
    set i: int64 = 0
    set n = raw_lines.len()

    while i < n {
        set raw_line = raw_lines[i]
        rewrite i = i + 1
        set line = trim(raw_line)

        if line.len() == 0 || starts_with(line, "#") {
            continue
        }

        if starts_with(line, "export ") {
            set line_len = line.len()
            set sliced = slice(line, 7, line_len)
            rewrite line = trim(sliced)
        }

        set eq_pos = index_of(line, "=")
        if eq_pos < 0 {
            continue
        }

        set key_slice = slice(line, 0, eq_pos)
        set key = trim(key_slice)
        if key.len() == 0 {
            continue
        }

        set line_len = line.len()
        set val_slice = slice(line, eq_pos + 1, line_len)
        set val_part = trim_start(val_slice)

        if starts_with(val_part, "'") {
            set vp_len = val_part.len()
            set val_content = slice(val_part, 1, vp_len)
            set close_quote = index_of(val_content, "'")
            if close_quote >= 0 {
                set val = slice(val_content, 0, close_quote)
                res.push(EnvEntry { key: key, value: val })
            } else {
                set multi_val = val_content
                while i < n {
                    set next_line = raw_lines[i]
                    rewrite i = i + 1
                    set q_pos = index_of(next_line, "'")
                    if q_pos >= 0 {
                        rewrite multi_val = multi_val + "\n" + slice(next_line, 0, q_pos)
                        break
                    } else {
                        rewrite multi_val = multi_val + "\n" + next_line
                    }
                }
                res.push(EnvEntry { key: key, value: multi_val })
            }
            continue
        }

        if starts_with(val_part, "\"") {
            set vp_len = val_part.len()
            set val_content = slice(val_part, 1, vp_len)
            set close_quote: int64 = -1
            set j: int64 = 0
            while j < val_content.len() {
                if val_content[j] == 34 { // "\""
                    if j == 0 || val_content[j - 1] != 92 { // not escaped
                        rewrite close_quote = j
                        break
                    }
                }
                rewrite j = j + 1
            }

            if close_quote >= 0 {
                set val = slice(val_content, 0, close_quote)
                set unescaped = unescape_double_quoted(val)
                set interpolated = interpolate_vars(unescaped, ref res)
                res.push(EnvEntry { key: key, value: interpolated })
            } else {
                set multi_val = val_content
                while i < n {
                    set next_line = raw_lines[i]
                    rewrite i = i + 1
                    set q_pos: int64 = -1
                    set k: int64 = 0
                    while k < next_line.len() {
                        if next_line[k] == 34 {
                            if k == 0 || next_line[k - 1] != 92 {
                                rewrite q_pos = k
                                break
                            }
                        }
                        rewrite k = k + 1
                    }

                    if q_pos >= 0 {
                        rewrite multi_val = multi_val + "\n" + slice(next_line, 0, q_pos)
                        break
                    } else {
                        rewrite multi_val = multi_val + "\n" + next_line
                    }
                }
                set unescaped = unescape_double_quoted(multi_val)
                set interpolated = interpolate_vars(unescaped, ref res)
                res.push(EnvEntry { key: key, value: interpolated })
            }
            continue
        }

        // unquoted val
        set comment_pos = index_of(val_part, " #")
        if comment_pos >= 0 {
            rewrite val_part = slice(val_part, 0, comment_pos)
        }
        set val = trim(val_part)
        set interpolated = interpolate_vars(val, ref res)
        res.push(EnvEntry { key: key, value: interpolated })
    }

    return res
}

public fun load_env(path: string = ".env") -> bool {
    if !file_exists(path.cp()) { return false }
    set content = file_read_text(path)
    set entries = parse_dotenv(content)
    for i in 0..entries.len() {
        if !has_env(entries[i].key.cp()) {
            set_env(entries[i].key.cp(), entries[i].value.cp())
        }
    }
    return true
}

public fun load_override(path: string = ".env") -> bool {
    if !file_exists(path.cp()) { return false }
    set content = file_read_text(path)
    set entries = parse_dotenv(content)
    for i in 0..entries.len() {
        set_env(entries[i].key.cp(), entries[i].value.cp())
    }
    return true
}

public fun dotenv(path: string = ".env") -> bool { return load_env(path) }
