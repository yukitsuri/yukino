load ..strings: slice, parse_int, parse_float
load .tokens: *

fun hex_val(b: uint8) -> int64 {
    if b >= 48 && b <= 57 { return cast(b - 48, "int64") }
    if b >= 65 && b <= 70 { return cast(b - 65 + 10, "int64") }
    if b >= 97 && b <= 102 { return cast(b - 97 + 10, "int64") }
    return -1
}

fun strip_underscores(s: string) -> string {
    set res: string = ""
    set i: int64 = 0
    set len: int64 = s.len()
    set chunk_start: int64 = 0
    while i < len {
        if s[i] == 95 {
            if i > chunk_start {
                rewrite res = res + slice(s, chunk_start, i)
            }
            rewrite chunk_start = i + 1
        }
        rewrite i = i + 1
    }
    if chunk_start < len {
        rewrite res = res + slice(s, chunk_start, len)
    }
    return res
}

public class TomlScanner {
    public text: string
    public len: int64
    public pos: int64
    public line: int64
    public col: int64
    public token_kind: int32
    public token_str: string
    public token_int: int64
    public token_float: float64
    public token_bool: bool
    public token_line: int64
    public token_col: int64
    public token_offset: int64
    public error_msg: string
    public has_error: bool

    public fun init(text: string) {
        rewrite this.text = text
        rewrite this.len = text.len()
        rewrite this.pos = 0
        rewrite this.line = 1
        rewrite this.col = 1
        rewrite this.token_kind = TOML_TOK_EOF
        rewrite this.token_str = ""
        rewrite this.token_int = 0
        rewrite this.token_float = 0.0
        rewrite this.token_bool = false
        rewrite this.token_line = 1
        rewrite this.token_col = 1
        rewrite this.token_offset = 0
        rewrite this.error_msg = ""
        rewrite this.has_error = false
    }

    fun is_digit(b: uint8) -> bool {
        return b >= 48 && b <= 57
    }

    fun is_bare_key_char(b: uint8) -> bool {
        return (b >= 97 && b <= 122) || (b >= 65 && b <= 90) || (b >= 48 && b <= 57) || b == 95 || b == 45
    }

    fun set_err(msg: string) -> int32 {
        rewrite this.has_error = true
        rewrite this.error_msg = msg
        rewrite this.token_kind = TOML_TOK_ERROR
        return TOML_TOK_ERROR
    }

    public fun scan() -> int32 {
        // Skip whitespace (spaces and tabs) and comments, but preserve newlines
        while this.pos < this.len {
            set b: uint8 = this.text[this.pos]
            if b == 32 || b == 9 || b == 13 {
                rewrite this.pos = this.pos + 1
                rewrite this.col = this.col + 1
            } elif b == 35 { // '#' comment
                while this.pos < this.len && this.text[this.pos] != 10 {
                    rewrite this.pos = this.pos + 1
                    rewrite this.col = this.col + 1
                }
            } else {
                break
            }
        }

        rewrite this.token_offset = this.pos
        rewrite this.token_line = this.line
        rewrite this.token_col = this.col

        if this.pos >= this.len {
            rewrite this.token_kind = TOML_TOK_EOF
            rewrite this.token_str = ""
            return TOML_TOK_EOF
        }

        set b: uint8 = this.text[this.pos]

        if b == 10 { // newline '\n'
            rewrite this.pos = this.pos + 1
            rewrite this.line = this.line + 1
            rewrite this.col = 1
            rewrite this.token_kind = TOML_TOK_NEWLINE
            rewrite this.token_str = "\n"
            return TOML_TOK_NEWLINE
        }

        if b == 61 { // '='
            rewrite this.pos = this.pos + 1
            rewrite this.col = this.col + 1
            rewrite this.token_kind = TOML_TOK_EQUAL
            return TOML_TOK_EQUAL
        }

        if b == 46 { // '.'
            rewrite this.pos = this.pos + 1
            rewrite this.col = this.col + 1
            rewrite this.token_kind = TOML_TOK_DOT
            return TOML_TOK_DOT
        }

        if b == 44 { // ','
            rewrite this.pos = this.pos + 1
            rewrite this.col = this.col + 1
            rewrite this.token_kind = TOML_TOK_COMMA
            return TOML_TOK_COMMA
        }

        if b == 91 { // '[' or '[['
            if this.pos + 1 < this.len && this.text[this.pos + 1] == 91 {
                rewrite this.pos = this.pos + 2
                rewrite this.col = this.col + 2
                rewrite this.token_kind = TOML_TOK_LDBRACKET
                return TOML_TOK_LDBRACKET
            }
            rewrite this.pos = this.pos + 1
            rewrite this.col = this.col + 1
            rewrite this.token_kind = TOML_TOK_LBRACKET
            return TOML_TOK_LBRACKET
        }

        if b == 93 { // ']' or ']]'
            if this.pos + 1 < this.len && this.text[this.pos + 1] == 93 {
                rewrite this.pos = this.pos + 2
                rewrite this.col = this.col + 2
                rewrite this.token_kind = TOML_TOK_RDBRACKET
                return TOML_TOK_RDBRACKET
            }
            rewrite this.pos = this.pos + 1
            rewrite this.col = this.col + 1
            rewrite this.token_kind = TOML_TOK_RBRACKET
            return TOML_TOK_RBRACKET
        }

        if b == 123 { // '{'
            rewrite this.pos = this.pos + 1
            rewrite this.col = this.col + 1
            rewrite this.token_kind = TOML_TOK_LBRACE
            return TOML_TOK_LBRACE
        }

        if b == 125 { // '}'
            rewrite this.pos = this.pos + 1
            rewrite this.col = this.col + 1
            rewrite this.token_kind = TOML_TOK_RBRACE
            return TOML_TOK_RBRACE
        }

        // Strings: """ or " or ''' or '
        if b == 34 { // '"'
            if this.pos + 2 < this.len && this.text[this.pos + 1] == 34 && this.text[this.pos + 2] == 34 {
                return this.scan_multiline_basic_string()
            }
            return this.scan_basic_string()
        }

        if b == 39 { // '\''
            if this.pos + 2 < this.len && this.text[this.pos + 1] == 39 && this.text[this.pos + 2] == 39 {
                return this.scan_multiline_literal_string()
            }
            return this.scan_literal_string()
        }

        // Check for booleans: true / false
        if b == 116 && this.pos + 4 <= this.len {
            if slice(this.text, this.pos, this.pos + 4) == "true" {
                if this.pos + 4 == this.len || !this.is_bare_key_char(this.text[this.pos + 4]) {
                    rewrite this.pos = this.pos + 4
                    rewrite this.col = this.col + 4
                    rewrite this.token_kind = TOML_TOK_BOOLEAN
                    rewrite this.token_bool = true
                    rewrite this.token_str = "true"
                    return TOML_TOK_BOOLEAN
                }
            }
        }
        if b == 102 && this.pos + 5 <= this.len {
            if slice(this.text, this.pos, this.pos + 5) == "false" {
                if this.pos + 5 == this.len || !this.is_bare_key_char(this.text[this.pos + 5]) {
                    rewrite this.pos = this.pos + 5
                    rewrite this.col = this.col + 5
                    rewrite this.token_kind = TOML_TOK_BOOLEAN
                    rewrite this.token_bool = false
                    rewrite this.token_str = "false"
                    return TOML_TOK_BOOLEAN
                }
            }
        }

        // Check for special float values: inf, +inf, -inf, nan, +nan, -nan
        if this.is_special_float() {
            return this.scan_special_float()
        }

        // Check for Datetime: YYYY-MM-DD or HH:MM:SS
        if this.is_datetime_prefix() {
            return this.scan_datetime()
        }

        // Check for number: digit or + or - followed by digit / 0x / 0o / 0b
        if this.is_digit(b) || ((b == 43 || b == 45) && this.pos + 1 < this.len && this.is_digit(this.text[this.pos + 1])) {
            return this.scan_number()
        }

        // Bare key / Identifier: [A-Za-z0-9_-]+
        if this.is_bare_key_char(b) {
            set start: int64 = this.pos
            while this.pos < this.len && this.is_bare_key_char(this.text[this.pos]) {
                rewrite this.pos = this.pos + 1
                rewrite this.col = this.col + 1
            }
            rewrite this.token_kind = TOML_TOK_IDENT
            rewrite this.token_str = slice(this.text, start, this.pos)
            return TOML_TOK_IDENT
        }

        return this.set_err("unexpected character in TOML input")
    }

    fun is_special_float() -> bool {
        set p: int64 = this.pos
        if p + 3 <= this.len {
            set s3: string = slice(this.text, p, p + 3)
            if s3 == "inf" || s3 == "nan" {
                if p + 3 == this.len || !this.is_bare_key_char(this.text[p + 3]) {
                    return true
                }
            }
        }
        if p + 4 <= this.len {
            set s4: string = slice(this.text, p, p + 4)
            if s4 == "+inf" || s4 == "-inf" || s4 == "+nan" || s4 == "-nan" {
                if p + 4 == this.len || !this.is_bare_key_char(this.text[p + 4]) {
                    return true
                }
            }
        }
        return false
    }

    fun scan_special_float() -> int32 {
        set start: int64 = this.pos
        while this.pos < this.len && this.is_bare_key_char(this.text[this.pos]) {
            rewrite this.pos = this.pos + 1
            rewrite this.col = this.col + 1
        }
        set s: string = slice(this.text, start, this.pos)
        rewrite this.token_kind = TOML_TOK_FLOAT
        rewrite this.token_str = s
        if s == "inf" || s == "+inf" {
            rewrite this.token_float = 1.0 / 0.0
        } elif s == "-inf" {
            rewrite this.token_float = -1.0 / 0.0
        } else {
            rewrite this.token_float = 0.0 / 0.0
        }
        return TOML_TOK_FLOAT
    }

    fun is_datetime_prefix() -> bool {
        // Date: YYYY-MM-DD (4 digits, '-', 2 digits, '-', 2 digits)
        if this.pos + 10 <= this.len {
            if this.is_digit(this.text[this.pos]) && this.is_digit(this.text[this.pos + 1])
                && this.is_digit(this.text[this.pos + 2]) && this.is_digit(this.text[this.pos + 3])
                && this.text[this.pos + 4] == 45
                && this.is_digit(this.text[this.pos + 5]) && this.is_digit(this.text[this.pos + 6])
                && this.text[this.pos + 7] == 45
                && this.is_digit(this.text[this.pos + 8]) && this.is_digit(this.text[this.pos + 9]) {
                return true
            }
        }
        // Time: HH:MM:SS
        if this.pos + 8 <= this.len {
            if this.is_digit(this.text[this.pos]) && this.is_digit(this.text[this.pos + 1])
                && this.text[this.pos + 2] == 58
                && this.is_digit(this.text[this.pos + 3]) && this.is_digit(this.text[this.pos + 4])
                && this.text[this.pos + 5] == 58
                && this.is_digit(this.text[this.pos + 6]) && this.is_digit(this.text[this.pos + 7]) {
                return true
            }
        }
        return false
    }

    fun scan_datetime() -> int32 {
        set start: int64 = this.pos
        while this.pos < this.len {
            set b: uint8 = this.text[this.pos]
            if this.is_digit(b) || b == 45 || b == 58 || b == 84 || b == 116 || b == 90 || b == 122 || b == 46 || b == 43 {
                rewrite this.pos = this.pos + 1
                rewrite this.col = this.col + 1
            } elif b == 32 && this.pos + 1 < this.len && this.is_digit(this.text[this.pos + 1]) {
                rewrite this.pos = this.pos + 1
                rewrite this.col = this.col + 1
            } else {
                break
            }
        }
        rewrite this.token_kind = TOML_TOK_DATETIME
        rewrite this.token_str = slice(this.text, start, this.pos)
        return TOML_TOK_DATETIME
    }

    fun scan_basic_string() -> int32 {
        rewrite this.pos = this.pos + 1
        rewrite this.col = this.col + 1
        set start: int64 = this.pos
        set has_escape: bool = false

        while this.pos < this.len {
            set b: uint8 = this.text[this.pos]
            if b == 34 { // '"'
                if !has_escape {
                    rewrite this.token_kind = TOML_TOK_STRING
                    rewrite this.token_str = slice(this.text, start, this.pos)
                    rewrite this.pos = this.pos + 1
                    rewrite this.col = this.col + 1
                    return TOML_TOK_STRING
                }
                break
            }
            if b == 92 { // '\'
                rewrite has_escape = true
                break
            }
            if b == 10 {
                return this.set_err("unescaped newline in basic string")
            }
            rewrite this.pos = this.pos + 1
            rewrite this.col = this.col + 1
        }

        if !has_escape {
            return this.set_err("unterminated basic string")
        }

        set res: string = slice(this.text, start, this.pos)
        set chunk_start: int64 = this.pos

        while this.pos < this.len {
            set b: uint8 = this.text[this.pos]
            if b == 34 { // '"'
                if this.pos > chunk_start {
                    rewrite res = res + slice(this.text, chunk_start, this.pos)
                }
                rewrite this.pos = this.pos + 1
                rewrite this.col = this.col + 1
                rewrite this.token_kind = TOML_TOK_STRING
                rewrite this.token_str = res
                return TOML_TOK_STRING
            }
            if b == 92 { // '\'
                if this.pos > chunk_start {
                    rewrite res = res + slice(this.text, chunk_start, this.pos)
                }
                rewrite this.pos = this.pos + 1
                rewrite this.col = this.col + 1
                if this.pos >= this.len {
                    return this.set_err("unexpected end of string escape")
                }
                set esc: uint8 = this.text[this.pos]
                rewrite this.pos = this.pos + 1
                rewrite this.col = this.col + 1
                if esc == 34 { rewrite res = res + "\"" }
                elif esc == 92 { rewrite res = res + "\\" }
                elif esc == 98 { set ch: char = cast(8, "char"); rewrite res = res + cast(ch, "string") }
                elif esc == 102 { set ch: char = cast(12, "char"); rewrite res = res + cast(ch, "string") }
                elif esc == 110 { rewrite res = res + "\n" }
                elif esc == 114 { rewrite res = res + "\r" }
                elif esc == 116 { rewrite res = res + "\t" }
                elif esc == 117 { // \uXXXX
                    if this.pos + 4 > this.len { return this.set_err("unexpected end of unicode escape") }
                    set h0: int64 = hex_val(this.text[this.pos])
                    set h1: int64 = hex_val(this.text[this.pos + 1])
                    set h2: int64 = hex_val(this.text[this.pos + 2])
                    set h3: int64 = hex_val(this.text[this.pos + 3])
                    if h0 < 0 || h1 < 0 || h2 < 0 || h3 < 0 { return this.set_err("invalid unicode escape") }
                    set cp: int64 = (h0 << 12) | (h1 << 8) | (h2 << 4) | h3
                    rewrite this.pos = this.pos + 4
                    rewrite this.col = this.col + 4
                    set ch: char = cast(cp, "char")
                    rewrite res = res + cast(ch, "string")
                }
                elif esc == 85 { // \UXXXXXXXX
                    if this.pos + 8 > this.len { return this.set_err("unexpected end of unicode escape") }
                    set cp: int64 = 0
                    set k: int64 = 0
                    while k < 8 {
                        set hv: int64 = hex_val(this.text[this.pos + k])
                        if hv < 0 { return this.set_err("invalid unicode escape") }
                        rewrite cp = (cp << 4) | hv
                        rewrite k = k + 1
                    }
                    rewrite this.pos = this.pos + 8
                    rewrite this.col = this.col + 8
                    set ch: char = cast(cp, "char")
                    rewrite res = res + cast(ch, "string")
                } else {
                    return this.set_err("invalid escape character in string")
                }
                rewrite chunk_start = this.pos
            } elif b == 10 {
                return this.set_err("unescaped newline in basic string")
            } else {
                rewrite this.pos = this.pos + 1
                rewrite this.col = this.col + 1
            }
        }
        return this.set_err("unterminated basic string")
    }

    fun scan_multiline_basic_string() -> int32 {
        rewrite this.pos = this.pos + 3
        rewrite this.col = this.col + 3
        // Trim immediate newline
        if this.pos < this.len && this.text[this.pos] == 13 {
            rewrite this.pos = this.pos + 1
        }
        if this.pos < this.len && this.text[this.pos] == 10 {
            rewrite this.pos = this.pos + 1
            rewrite this.line = this.line + 1
            rewrite this.col = 1
        }

        set res: string = ""
        set chunk_start: int64 = this.pos

        while this.pos < this.len {
            // Check for closing """
            if this.text[this.pos] == 34 && this.pos + 2 < this.len && this.text[this.pos + 1] == 34 && this.text[this.pos + 2] == 34 {
                if this.pos > chunk_start {
                    rewrite res = res + slice(this.text, chunk_start, this.pos)
                }
                rewrite this.pos = this.pos + 3
                rewrite this.col = this.col + 3
                rewrite this.token_kind = TOML_TOK_STRING
                rewrite this.token_str = res
                return TOML_TOK_STRING
            }

            set b: uint8 = this.text[this.pos]
            if b == 10 {
                rewrite this.pos = this.pos + 1
                rewrite this.line = this.line + 1
                rewrite this.col = 1
            } elif b == 92 { // '\'
                if this.pos > chunk_start {
                    rewrite res = res + slice(this.text, chunk_start, this.pos)
                }
                rewrite this.pos = this.pos + 1
                rewrite this.col = this.col + 1
                if this.pos >= this.len {
                    return this.set_err("unexpected end of string escape")
                }
                set esc: uint8 = this.text[this.pos]
                // Line-ending backslash: trim whitespace and newlines
                if esc == 10 || esc == 13 || esc == 32 || esc == 9 {
                    set is_line_end: bool = false
                    set temp_p: int64 = this.pos
                    while temp_p < this.len && (this.text[temp_p] == 32 || this.text[temp_p] == 9 || this.text[temp_p] == 13) {
                        rewrite temp_p = temp_p + 1
                    }
                    if temp_p < this.len && this.text[temp_p] == 10 {
                        rewrite is_line_end = true
                    }
                    if is_line_end {
                        rewrite this.pos = temp_p + 1
                        rewrite this.line = this.line + 1
                        rewrite this.col = 1
                        while this.pos < this.len {
                            set nb: uint8 = this.text[this.pos]
                            if nb == 32 || nb == 9 || nb == 13 {
                                rewrite this.pos = this.pos + 1
                                rewrite this.col = this.col + 1
                            } elif nb == 10 {
                                rewrite this.pos = this.pos + 1
                                rewrite this.line = this.line + 1
                                rewrite this.col = 1
                            } else {
                                break
                            }
                        }
                        rewrite chunk_start = this.pos
                        continue
                    }
                }

                rewrite this.pos = this.pos + 1
                rewrite this.col = this.col + 1
                if esc == 34 { rewrite res = res + "\"" }
                elif esc == 92 { rewrite res = res + "\\" }
                elif esc == 98 { set ch: char = cast(8, "char"); rewrite res = res + cast(ch, "string") }
                elif esc == 102 { set ch: char = cast(12, "char"); rewrite res = res + cast(ch, "string") }
                elif esc == 110 { rewrite res = res + "\n" }
                elif esc == 114 { rewrite res = res + "\r" }
                elif esc == 116 { rewrite res = res + "\t" }
                elif esc == 117 {
                    if this.pos + 4 > this.len { return this.set_err("unexpected end of unicode escape") }
                    set h0: int64 = hex_val(this.text[this.pos])
                    set h1: int64 = hex_val(this.text[this.pos + 1])
                    set h2: int64 = hex_val(this.text[this.pos + 2])
                    set h3: int64 = hex_val(this.text[this.pos + 3])
                    if h0 < 0 || h1 < 0 || h2 < 0 || h3 < 0 { return this.set_err("invalid unicode escape") }
                    set cp: int64 = (h0 << 12) | (h1 << 8) | (h2 << 4) | h3
                    rewrite this.pos = this.pos + 4
                    rewrite this.col = this.col + 4
                    set ch: char = cast(cp, "char")
                    rewrite res = res + cast(ch, "string")
                } else {
                    return this.set_err("invalid escape in multiline basic string")
                }
                rewrite chunk_start = this.pos
            } else {
                rewrite this.pos = this.pos + 1
                rewrite this.col = this.col + 1
            }
        }
        return this.set_err("unterminated multiline basic string")
    }

    fun scan_literal_string() -> int32 {
        rewrite this.pos = this.pos + 1
        rewrite this.col = this.col + 1
        set start: int64 = this.pos
        while this.pos < this.len {
            set b: uint8 = this.text[this.pos]
            if b == 39 { // '\''
                set res: string = slice(this.text, start, this.pos)
                rewrite this.pos = this.pos + 1
                rewrite this.col = this.col + 1
                rewrite this.token_kind = TOML_TOK_STRING
                rewrite this.token_str = res
                return TOML_TOK_STRING
            }
            if b == 10 {
                return this.set_err("unescaped newline in literal string")
            }
            rewrite this.pos = this.pos + 1
            rewrite this.col = this.col + 1
        }
        return this.set_err("unterminated literal string")
    }

    fun scan_multiline_literal_string() -> int32 {
        rewrite this.pos = this.pos + 3
        rewrite this.col = this.col + 3
        // Trim immediate newline
        if this.pos < this.len && this.text[this.pos] == 13 {
            rewrite this.pos = this.pos + 1
        }
        if this.pos < this.len && this.text[this.pos] == 10 {
            rewrite this.pos = this.pos + 1
            rewrite this.line = this.line + 1
            rewrite this.col = 1
        }

        set start: int64 = this.pos
        while this.pos < this.len {
            if this.text[this.pos] == 39 && this.pos + 2 < this.len && this.text[this.pos + 1] == 39 && this.text[this.pos + 2] == 39 {
                set res: string = slice(this.text, start, this.pos)
                rewrite this.pos = this.pos + 3
                rewrite this.col = this.col + 3
                rewrite this.token_kind = TOML_TOK_STRING
                rewrite this.token_str = res
                return TOML_TOK_STRING
            }
            if this.text[this.pos] == 10 {
                rewrite this.pos = this.pos + 1
                rewrite this.line = this.line + 1
                rewrite this.col = 1
            } else {
                rewrite this.pos = this.pos + 1
                rewrite this.col = this.col + 1
            }
        }
        return this.set_err("unterminated multiline literal string")
    }

    fun scan_number() -> int32 {
        set start: int64 = this.pos
        set is_float_num: bool = false

        // Check hex 0x, oct 0o, bin 0b
        if this.text[this.pos] == 48 && this.pos + 1 < this.len {
            set prefix: uint8 = this.text[this.pos + 1]
            if prefix == 120 || prefix == 88 { // 'x', 'X'
                rewrite this.pos = this.pos + 2
                rewrite this.col = this.col + 2
                set hex_start: int64 = this.pos
                while this.pos < this.len && (hex_val(this.text[this.pos]) >= 0 || this.text[this.pos] == 95) {
                    rewrite this.pos = this.pos + 1
                    rewrite this.col = this.col + 1
                }
                set raw: string = strip_underscores(slice(this.text, hex_start, this.pos))
                set val: int64 = 0
                set i: int64 = 0
                while i < raw.len() {
                    set hv: int64 = hex_val(raw[i])
                    if hv >= 0 {
                        rewrite val = (val << 4) | hv
                    }
                    rewrite i = i + 1
                }
                rewrite this.token_kind = TOML_TOK_INTEGER
                rewrite this.token_int = val
                rewrite this.token_float = cast(val, "float64")
                rewrite this.token_str = slice(this.text, start, this.pos)
                return TOML_TOK_INTEGER
            }
            if prefix == 111 || prefix == 79 { // 'o', 'O'
                rewrite this.pos = this.pos + 2
                rewrite this.col = this.col + 2
                set oct_start: int64 = this.pos
                while this.pos < this.len && ((this.text[this.pos] >= 48 && this.text[this.pos] <= 55) || this.text[this.pos] == 95) {
                    rewrite this.pos = this.pos + 1
                    rewrite this.col = this.col + 1
                }
                set raw: string = strip_underscores(slice(this.text, oct_start, this.pos))
                set val: int64 = 0
                set i: int64 = 0
                while i < raw.len() {
                    rewrite val = (val << 3) | cast(raw[i] - 48, "int64")
                    rewrite i = i + 1
                }
                rewrite this.token_kind = TOML_TOK_INTEGER
                rewrite this.token_int = val
                rewrite this.token_float = cast(val, "float64")
                rewrite this.token_str = slice(this.text, start, this.pos)
                return TOML_TOK_INTEGER
            }
            if prefix == 98 || prefix == 66 { // 'b', 'B'
                rewrite this.pos = this.pos + 2
                rewrite this.col = this.col + 2
                set bin_start: int64 = this.pos
                while this.pos < this.len && (this.text[this.pos] == 48 || this.text[this.pos] == 49 || this.text[this.pos] == 95) {
                    rewrite this.pos = this.pos + 1
                    rewrite this.col = this.col + 1
                }
                set raw: string = strip_underscores(slice(this.text, bin_start, this.pos))
                set val: int64 = 0
                set i: int64 = 0
                while i < raw.len() {
                    rewrite val = (val << 1) | cast(raw[i] - 48, "int64")
                    rewrite i = i + 1
                }
                rewrite this.token_kind = TOML_TOK_INTEGER
                rewrite this.token_int = val
                rewrite this.token_float = cast(val, "float64")
                rewrite this.token_str = slice(this.text, start, this.pos)
                return TOML_TOK_INTEGER
            }
        }

        // Standard decimal int or float
        if this.text[this.pos] == 43 || this.text[this.pos] == 45 {
            rewrite this.pos = this.pos + 1
            rewrite this.col = this.col + 1
        }
        while this.pos < this.len && (this.is_digit(this.text[this.pos]) || this.text[this.pos] == 95) {
            rewrite this.pos = this.pos + 1
            rewrite this.col = this.col + 1
        }

        if this.pos < this.len && this.text[this.pos] == 46 { // '.'
            // Check if followed by digit (so it's float, not dotted key)
            if this.pos + 1 < this.len && this.is_digit(this.text[this.pos + 1]) {
                rewrite is_float_num = true
                rewrite this.pos = this.pos + 1
                rewrite this.col = this.col + 1
                while this.pos < this.len && (this.is_digit(this.text[this.pos]) || this.text[this.pos] == 95) {
                    rewrite this.pos = this.pos + 1
                    rewrite this.col = this.col + 1
                }
            }
        }

        if this.pos < this.len && (this.text[this.pos] == 101 || this.text[this.pos] == 69) { // 'e' or 'E'
            rewrite is_float_num = true
            rewrite this.pos = this.pos + 1
            rewrite this.col = this.col + 1
            if this.pos < this.len && (this.text[this.pos] == 43 || this.text[this.pos] == 45) {
                rewrite this.pos = this.pos + 1
                rewrite this.col = this.col + 1
            }
            while this.pos < this.len && (this.is_digit(this.text[this.pos]) || this.text[this.pos] == 95) {
                rewrite this.pos = this.pos + 1
                rewrite this.col = this.col + 1
            }
        }

        set raw_str: string = slice(this.text, start, this.pos)
        set clean_str: string = strip_underscores(raw_str)

        if is_float_num {
            set parsed = parse_float(clean_str)
            if parsed == null { return this.set_err("failed to parse TOML float") }
            rewrite this.token_kind = TOML_TOK_FLOAT
            rewrite this.token_float = parsed ?? 0.0
            rewrite this.token_int = cast(this.token_float, "int64")
            rewrite this.token_str = raw_str
            return TOML_TOK_FLOAT
        }

        set parsed_i = parse_int(clean_str)
        if parsed_i == null {
            set parsed_f = parse_float(clean_str)
            if parsed_f != null {
                rewrite this.token_kind = TOML_TOK_INTEGER
                rewrite this.token_int = cast(parsed_f ?? 0.0, "int64")
                rewrite this.token_float = parsed_f ?? 0.0
                rewrite this.token_str = raw_str
                return TOML_TOK_INTEGER
            }
            return this.set_err("failed to parse TOML integer")
        }

        rewrite this.token_kind = TOML_TOK_INTEGER
        rewrite this.token_int = parsed_i ?? 0
        rewrite this.token_float = cast(this.token_int, "float64")
        rewrite this.token_str = raw_str
        return TOML_TOK_INTEGER
    }
}
