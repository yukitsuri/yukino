load core.utils: cast
load .common: MIX_SEED, RNG_SEED, Rng, mix, alloc_u32, free_u32

static CHACHA_BLOCKS: int32 = 2000000
static CHACHA_WORDS: int64 = 16
static CHACHA_DOUBLE_ROUNDS: int32 = 10

#[stable, inline_always]
fun rol(x: uint32, n: uint32) -> uint32 {
    return (x << n) | (x >> (32u32 - n))
}

#[inline_always]
fun chacha_block(ref input: uint32[], ref ~out: uint32[]) {
    for i in 0..CHACHA_WORDS {
        rewrite out[i] = input[i]
    }
    for r in 0..CHACHA_DOUBLE_ROUNDS {
        rewrite out[0] = out[0] + out[4]; rewrite out[12] = rol(out[12] ^ out[0], 16u32); rewrite out[8] = out[8] + out[12]; rewrite out[4] = rol(out[4] ^ out[8], 12u32)
        rewrite out[0] = out[0] + out[4]; rewrite out[12] = rol(out[12] ^ out[0], 8u32); rewrite out[8] = out[8] + out[12]; rewrite out[4] = rol(out[4] ^ out[8], 7u32)

        rewrite out[1] = out[1] + out[5]; rewrite out[13] = rol(out[13] ^ out[1], 16u32); rewrite out[9] = out[9] + out[13]; rewrite out[5] = rol(out[5] ^ out[9], 12u32)
        rewrite out[1] = out[1] + out[5]; rewrite out[13] = rol(out[13] ^ out[1], 8u32); rewrite out[9] = out[9] + out[13]; rewrite out[5] = rol(out[5] ^ out[9], 7u32)

        rewrite out[2] = out[2] + out[6]; rewrite out[14] = rol(out[14] ^ out[2], 16u32); rewrite out[10] = out[10] + out[14]; rewrite out[6] = rol(out[6] ^ out[10], 12u32)
        rewrite out[2] = out[2] + out[6]; rewrite out[14] = rol(out[14] ^ out[2], 8u32); rewrite out[10] = out[10] + out[14]; rewrite out[6] = rol(out[6] ^ out[10], 7u32)

        rewrite out[3] = out[3] + out[7]; rewrite out[15] = rol(out[15] ^ out[3], 16u32); rewrite out[11] = out[11] + out[15]; rewrite out[7] = rol(out[7] ^ out[11], 12u32)
        rewrite out[3] = out[3] + out[7]; rewrite out[15] = rol(out[15] ^ out[3], 8u32); rewrite out[11] = out[11] + out[15]; rewrite out[7] = rol(out[7] ^ out[11], 7u32)

        rewrite out[0] = out[0] + out[5]; rewrite out[15] = rol(out[15] ^ out[0], 16u32); rewrite out[10] = out[10] + out[15]; rewrite out[5] = rol(out[5] ^ out[10], 12u32)
        rewrite out[0] = out[0] + out[5]; rewrite out[15] = rol(out[15] ^ out[0], 8u32); rewrite out[10] = out[10] + out[15]; rewrite out[5] = rol(out[5] ^ out[10], 7u32)

        rewrite out[1] = out[1] + out[6]; rewrite out[12] = rol(out[12] ^ out[1], 16u32); rewrite out[11] = out[11] + out[12]; rewrite out[6] = rol(out[6] ^ out[11], 12u32)
        rewrite out[1] = out[1] + out[6]; rewrite out[12] = rol(out[12] ^ out[1], 8u32); rewrite out[11] = out[11] + out[12]; rewrite out[6] = rol(out[6] ^ out[11], 7u32)

        rewrite out[2] = out[2] + out[7]; rewrite out[13] = rol(out[13] ^ out[2], 16u32); rewrite out[8] = out[8] + out[13]; rewrite out[7] = rol(out[7] ^ out[8], 12u32)
        rewrite out[2] = out[2] + out[7]; rewrite out[13] = rol(out[13] ^ out[2], 8u32); rewrite out[8] = out[8] + out[13]; rewrite out[7] = rol(out[7] ^ out[8], 7u32)

        rewrite out[3] = out[3] + out[4]; rewrite out[14] = rol(out[14] ^ out[3], 16u32); rewrite out[9] = out[9] + out[14]; rewrite out[4] = rol(out[4] ^ out[9], 12u32)
        rewrite out[3] = out[3] + out[4]; rewrite out[14] = rol(out[14] ^ out[3], 8u32); rewrite out[9] = out[9] + out[14]; rewrite out[4] = rol(out[4] ^ out[9], 7u32)
    }
    for i in 0..CHACHA_WORDS {
        rewrite out[i] = out[i] + input[i]
    }
}

#[region::capacity(4096)]
public fun chacha_test() -> uint64 {
    set st = alloc_u32(CHACHA_WORDS)
    set out = alloc_u32(CHACHA_WORDS)
    set r = init Rng(RNG_SEED)
    rewrite st[0] = 0x61707865u32
    rewrite st[1] = 0x3320646eu32
    rewrite st[2] = 0x79622d32u32
    rewrite st[3] = 0x6b206574u32
    for i in 4..CHACHA_WORDS {
        rewrite st[i] = cast(r.next(), "uint32")
    }
    set acc: uint32 = 0
    for c in 0..CHACHA_BLOCKS {
        rewrite st[12] = cast(c, "uint32")
        chacha_block(ref st, ref ~out)
        for i in 0..CHACHA_WORDS {
            rewrite acc = acc ^ out[i]
        }
    }
    set res: uint64 = mix(MIX_SEED, cast(acc, "uint64"))
    free_u32(st)
    free_u32(out)
    return res
}
