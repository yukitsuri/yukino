        rewrite this.t1 = this.cv7 + (ror(this.cv4, 6u32) ^ ror(this.cv4, 11u32) ^ ror(this.cv4, 25u32)) + ((this.cv4 & this.cv5) ^ ((~this.cv4) & this.cv6)) + k[63] + this.b15
        rewrite this.t2 = (ror(this.cv0, 2u32) ^ ror(this.cv0, 13u32) ^ ror(this.cv0, 22u32)) + ((this.cv0 & this.cv1) ^ (this.cv0 & this.cv2) ^ (this.cv1 & this.cv2))
        rewrite this.cv7 = this.cv6; rewrite this.cv6 = this.cv5; rewrite this.cv5 = this.cv4; rewrite this.cv4 = this.cv3 + this.t1; rewrite this.cv3 = this.cv2; rewrite this.cv2 = this.cv1; rewrite this.cv1 = this.cv0; rewrite this.cv0 = this.t1 + this.t2

        // fold back into saved state
        rewrite this.cv0 = h0 + this.cv0
        rewrite this.cv1 = h1 + this.cv1
        rewrite this.cv2 = h2 + this.cv2
        rewrite this.cv3 = h3 + this.cv3
        rewrite this.cv4 = h4 + this.cv4
        rewrite this.cv5 = h5 + this.cv5
        rewrite this.cv6 = h6 + this.cv6
        rewrite this.cv7 = h7 + this.cv7
    }

    // Full blocks word-packed, tail bytes via set_buf_byte.
    fun update(ref p: bytes, start: int64, len: int64, ref k: uint32[]) {
        if len <= 0 { return }
        set off: int64 = start
        set end: int64 = start + len
        while off < end {
            if this.fill == 0 && off + 64 <= end {
                this.load_block(ref p, off)
                this.compress(ref k)
                rewrite off = off + 64
            } else {
                this.set_buf_byte(this.fill, p[off])
                rewrite this.fill = this.fill + 1
                if this.fill == 64 {
                    rewrite this.fill = 0
                    this.compress(ref k)
                }
                rewrite off = off + 1
            }
        }
        rewrite this.total = this.total + cast(len, "uint64")
    }

    // Pad, final compress, fold state into uint64.
    fun final(ref k: uint32[]) -> uint64 {
        set bits: uint64 = this.total * 8u64
        this.set_buf_byte(this.fill, 0x80u8)
        rewrite this.fill = this.fill + 1
        if this.fill > 56 {
            while this.fill < 64 {
                this.set_buf_byte(this.fill, 0u8)
                rewrite this.fill = this.fill + 1
            }
            rewrite this.fill = 0
            this.compress(ref k)
        }
        while this.fill < 56 {
            this.set_buf_byte(this.fill, 0u8)
            rewrite this.fill = this.fill + 1
        }
        set i: int64 = 0
        while i < 8 {
            this.set_buf_byte(63 - i, cast(bits >> cast(8 * i, "uint64"), "uint8"))
            rewrite i = i + 1
        }
        this.compress(ref k)
        set res: uint64 = MIX_SEED
        rewrite res = mix(res, cast(this.cv0, "uint64"))
        rewrite res = mix(res, cast(this.cv1, "uint64"))
        rewrite res = mix(res, cast(this.cv2, "uint64"))
        rewrite res = mix(res, cast(this.cv3, "uint64"))
        rewrite res = mix(res, cast(this.cv4, "uint64"))
        rewrite res = mix(res, cast(this.cv5, "uint64"))
        rewrite res = mix(res, cast(this.cv6, "uint64"))
        rewrite res = mix(res, cast(this.cv7, "uint64"))
        return res
    }
}

public fun sha256_test() -> uint64 {
    set buf = make_buf()
    set k = init_sha_k()
    set sha = init Sha256()
    for pass in 0..SHA_PASSES {
        sha.update(ref buf, 0, HASH_BUF_BYTES, ref k)
    }
    set res = sha.final(ref k)
    free_u8(buf)
    free_u32(k)
    return res
}

public fun crc32_test() -> uint64 {
    set buf = make_buf()
    set table = alloc_u32(256)
    for n in 0..256 {
        set c: uint32 = cast(n, "uint32")
        for i in 0..8 {
            if c & 1u32 != 0u32 {
                rewrite c = (c >> 1u32) ^ CRC_POLY
            } else {
                rewrite c = c >> 1u32
            }
        }
        rewrite table[n] = c
    }
    set crc: uint32 = 0xffffffffu32
    for pass in 0..CRC_PASSES {
        for i in 0..HASH_BUF_BYTES {
            set idx: int64 = cast((crc ^ cast(buf[i], "uint32")) & 0xffu32, "int64")
            rewrite crc = table[idx] ^ (crc >> 8u32)
        }
    }
    set res: uint64 = mix(MIX_SEED, cast(~crc, "uint64"))
    free_u8(buf)
    free_u32(table)
    return res
}

public fun fnv_test() -> uint64 {
    set buf = make_buf()
    set h: uint64 = MIX_SEED
    for pass in 0..FNV_PASSES {
        for i in 0..HASH_BUF_BYTES {
            rewrite h = mix(h, cast(buf[i], "uint64"))
        }
    }
    free_u8(buf)
    return h
}
