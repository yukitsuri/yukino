load core.utils: cast
load .common: MIX_SEED, RNG_SEED, Rng, mix, alloc_u64, free_u64

static MAP_BITS: int32 = 22
static MAP_SIZE: int64 = 4194304
static MAP_INSERTS: int64 = 2000000
static MAP_MISSES: int64 = 1000000
static MAP_HASH_MUL: uint64 = 0x9e3779b97f4a7c15u64
static MAP_MISSING: uint64 = 0xffffffffffffffffu64
static MISS_SEED: uint64 = 0x2545f4914f6cdd1du64

class Table {
    keys: uint64[]
    vals: uint64[]

    fun init() {
        rewrite this.keys = alloc_u64(MAP_SIZE)
        rewrite this.vals = alloc_u64(MAP_SIZE)
    }

    #[inline_always]
    fun put(key: uint64, val: uint64) {
        set keys = this.keys
        set vals = this.vals
        set mask: int64 = MAP_SIZE - 1
        set s: int64 = cast((key * MAP_HASH_MUL) >> 42u64, "int64")
        while true {
            set k: uint64 = keys[s]
            if k == 0u64 || k == key {
                break
            }
            rewrite s = (s + 1) & mask
        }
        rewrite keys[s] = key
        rewrite vals[s] = val
    }

    #[inline_always]
    fun lookup(key: uint64) -> uint64 {
        set keys = this.keys
        set mask: int64 = MAP_SIZE - 1
        set s: int64 = cast((key * MAP_HASH_MUL) >> 42u64, "int64")
        while true {
            set k: uint64 = keys[s]
            if k == 0u64 {
                return MAP_MISSING
            }
            if k == key {
                return this.vals[s]
            }
            rewrite s = (s + 1) & mask
        }
        return MAP_MISSING
    }

    fun destroy() {
        free_u64(this.keys)
        free_u64(this.vals)
    }
}

#[region::capacity(4096)]
public fun hashmap_test() -> uint64 {
    set table = init Table()
    set r = init Rng(RNG_SEED)
    for i in 0..MAP_INSERTS {
        table.put(r.next() | 1u64, cast(i, "uint64"))
    }
    set again = init Rng(RNG_SEED)
    set sum: uint64 = 0
    for i in 0..MAP_INSERTS {
        rewrite sum = sum + table.lookup(again.next() | 1u64)
    }
    set miss = init Rng(MISS_SEED)
    set misses: uint64 = 0
    for i in 0..MAP_MISSES {
        set v: uint64 = table.lookup(miss.next() | 1u64)
        if v == MAP_MISSING {
            rewrite misses = misses + 1
        } else {
            rewrite sum = sum + v
        }
    }
    table.destroy()
    return mix(mix(MIX_SEED, sum), misses)
}
