load std.io: print
load core.mem: Arena, export, persistent, region_used, region_cap, region_reset

struct Payload {
    val: int64
}

fun consume(p: Payload) -> int64 {
    return p.val
}

fun inspect(ref p: Payload) -> int64 {
    return p.val
}

public fun test_memory() {
    // 1. Move semantics
    set p1 = Payload { val: 42 }
    set p2 = p1
    set res = consume(p2)

    // 2. Borrowing (immutable reference ref)
    set p3 = Payload { val: 100 }
    set read_val = inspect(ref p3)

    // 3. Explicit region
    region {
        set temp = Payload { val: 300 }
        set temp_read = inspect(ref temp)
    }

    // 4. Region metrics and reset
    set cap_val = region_cap()
    set used_val = region_used()
    region_reset()

    // 5. Arena
    set pool = init Arena(64 * 1024)
    defer {
        pool.destroy()
    }
    region(pool) {
        set s = "test arena"
        space
    }
    pool.reset()

    // 6. Export and persistent
    set exp_res = region {
        set inner = "hello " + "world"
        export(inner)
    }
    set pers_res = persistent("global str")

    // 7. Defer
    defer {
        print("Defer in test_memory executed\n")
    }

    // 8. Sus / Catch / Finally
    sus {
        // Safe block
        space
    } catch {
        space
    } finally {
        space
    }

    print("Memory OK\n")
}
