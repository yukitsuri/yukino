public fun plus_calc(a: int64, b: int64) -> int64 {
    return a + b
}

public fun minus_calc(a: int64, b: int64) -> int64 {
    return a - b
}

public fun dv_calc(a: int64, b: int64) -> int64 {
    if b == 0 {
        return null
    }

    return a / b
}

public fun ml_calc(a: int64, b: int64) -> int64 {
    return a * b
}
